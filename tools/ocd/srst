#!/usr/bin/env python3
"""Hard-reset the tablet through the EUD SRST line.  Run with venv/bin/python.
Kills any OpenOCD (its USB handles die with every hub re-enumeration), starts a fresh
server, whose init enables the SWD function, pulses SRST and reports what the SoC
came up as.  Works from Linux, U-Boot and EDL alike; from a running system expect EDL
next, from EDL expect a normal boot.  Never SRST a box you can't afford to see in EDL."""
import contextlib
import os
import socket
import subprocess
import sys
import time

import usb.core

VID, HUB, SWD = 0x05C6, 0x9500, 0x9504
HERE = os.path.dirname(os.path.abspath(__file__))


def swd_up():
    return usb.core.find(idVendor=VID, idProduct=SWD,
                         custom_match=lambda d: d.parent and d.parent.idProduct == HUB)


def main():
    subprocess.run(["pkill", "-x", "openocd"], capture_output=True)
    time.sleep(1)
    subprocess.Popen([os.path.join(HERE, "server"), "-c", "init"], stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True)

    for _ in range(100):                                  # the fresh init enables the SWD function
        with contextlib.suppress(OSError):
            socket.create_connection(("127.0.0.1", 6666), timeout=1).close()
            if swd_up():
                break
        time.sleep(0.2)
    else:
        sys.exit("no SWD function behind the hub: no EUD hub, or CTL won't enable it")

    subprocess.run([os.path.join(HERE, "oc"), "reset_config srst_only srst_push_pull",
                    "reset run"], capture_output=True, text=True, timeout=20)
    subprocess.run(["pkill", "-x", "openocd"], capture_output=True)   # its handles die anyway

    for _ in range(40):                                   # what did the SoC come up as?
        time.sleep(1)
        pids = sorted({f"{d.idProduct:04x}" for d in usb.core.find(find_all=True)
                       if d.idVendor == VID and d.idProduct in (0x9500, 0x9008, 0x900e)})
        if pids:
            print("reset done, USB now: " + ", ".join(pids) +
                  (" (EDL)" if "9500" not in pids else " (booting)"), flush=True)
            return
    print("reset sent, but no EUD/EDL USB within 40 s")


if __name__ == "__main__":
    main()
