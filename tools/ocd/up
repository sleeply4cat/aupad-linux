#!/usr/bin/env python3
"""Get the OpenOCD server running on the tablet, from whatever state it's in.  Run with venv/bin/python.
Resets the EUD hub when its control function is missing, which happens on some boots.  Exits 1 if the RPM won't answer."""
import contextlib
import os
import socket
import subprocess
import sys
import time

import usb.core
import usb.util

VID, HUB, CTL = 0x05C6, 0x9500, 0x9501
HERE = os.path.dirname(os.path.abspath(__file__))


def ctl():
    # Other devices on this host reuse 05c6:9501
    return usb.core.find(idVendor=VID, idProduct=CTL, custom_match=lambda d: d.parent and d.parent.idProduct == HUB)


def running():
    with contextlib.suppress(OSError):
        socket.create_connection(("127.0.0.1", 6666), timeout=1).close()
        return True
    return False


def answers():
    r = subprocess.run([os.path.join(HERE, "oc"), "rpm mdw 0xE000ED00"], capture_output=True, text=True, timeout=30)
    return "412fc231" in r.stdout


if running() and answers():
    sys.exit(print("server already up"))
subprocess.run([os.path.join(HERE, "oc"), "shutdown"], capture_output=True, timeout=30) if running() else None

for attempt in range(4):
    for _ in range(40):
        if ctl():
            break
        time.sleep(0.2)
    else:
        hub = usb.core.find(idVendor=VID, idProduct=HUB)
        if not hub:
            sys.exit("no EUD hub: stub image not booted, or EUD window missed")
        print("resetting the EUD hub")
        with contextlib.suppress(usb.core.USBError):
            hub.reset()
        continue
    usb.util.dispose_resources(ctl())
    subprocess.Popen([os.path.join(HERE, "server"), "-c", "init"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     start_new_session=True)
    for _ in range(50):
        if running():
            break
        time.sleep(0.1)
    if running() and answers():
        sys.exit(print("server up"))
    if running():
        subprocess.run([os.path.join(HERE, "oc"), "shutdown"], capture_output=True, timeout=30)
sys.exit("the RPM doesn't answer")
