+/* Other devices reuse these IDs: only trust functions behind the EUD hub */
+static libusb_device_handle *eud_open_behind_hub(uint16_t pid)
+{
+	libusb_device **list;
+	libusb_device_handle *handle = NULL;
+
+	ssize_t count = libusb_get_device_list(eud_libusb_ctx, &list);
+	if (count < 0)
+		return NULL;
+
+	for (ssize_t i = 0; i < count && !handle; i++) {
+		struct libusb_device_descriptor desc, hub_desc;
+		libusb_device *hub = libusb_get_parent(list[i]);
+
+		if (!hub ||
+			libusb_get_device_descriptor(list[i], &desc) != LIBUSB_SUCCESS ||
+			libusb_get_device_descriptor(hub, &hub_desc) != LIBUSB_SUCCESS)
+			continue;
+
+		if (desc.idVendor == EUD_VID && desc.idProduct == pid &&
+			hub_desc.idVendor == EUD_VID && hub_desc.idProduct == EUD_HUB_PID)
+			if (libusb_open(list[i], &handle) != LIBUSB_SUCCESS)
+				handle = NULL;
+	}
+
+	libusb_free_device_list(list, 1);
+	return handle;
+}
