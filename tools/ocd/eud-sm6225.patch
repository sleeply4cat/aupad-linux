-			LOG_TARGET_INFO(target, "external reset detected");
+			LOG_TARGET_DEBUG(target, "external reset detected");	/* every power collapse */
 			if (armv8->arm.core_cache) {
 				register_cache_invalidate(armv8->arm.core_cache);
 				register_cache_invalidate(armv8->arm.core_cache->next);
@@ -3229,6 +3229,60 @@ COMMAND_HANDLER(aarch64_mcrmrc_command)
 	return ERROR_OK;
 }
 
+/* mrc above refuses AArch64.  Goes through x0, which debug entry marks dirty, so it comes back on resume. */
+COMMAND_HANDLER(aarch64_mrs_command)
+{
+	if (CMD_ARGC != 5)
+		return ERROR_COMMAND_SYNTAX_ERROR;
+
+	struct target *target = get_current_target(CMD_CTX);
+	if (!target_was_examined(target)) {
+		command_print(CMD, "%s: not yet examined", target_name(target));
+		return ERROR_TARGET_NOT_EXAMINED;
+	}
+	if (target->state != TARGET_HALTED) {
+		command_print(CMD, "Error: [%s] not halted", target_name(target));
+		return ERROR_TARGET_NOT_HALTED;
+	}
+
+	struct arm *arm = target_to_arm(target);
+	if (arm->core_state != ARM_STATE_AARCH64) {
+		command_print(CMD, "%s: not in AArch64 state", target_name(target));
+		return ERROR_FAIL;
+	}
+
+	uint32_t f[5];
+	static const uint32_t limit[5] = { 3, 7, 15, 15, 7 };
+	for (unsigned int i = 0; i < 5; i++) {
+		COMMAND_PARSE_NUMBER(u32, CMD_ARGV[i], f[i]);
+		if (f[i] > limit[i])
+			return ERROR_COMMAND_ARGUMENT_INVALID;
+	}
+	uint32_t sys = f[0] << 14 | f[1] << 11 | f[2] << 7 | f[3] << 3 | f[4];
+
+	struct arm_dpm *dpm = arm->dpm;
+	int retval = dpm->prepare(dpm);
+	if (retval != ERROR_OK)
+		return retval;
+
+	/* EL1 registers can't be read from EL0 */
+	bool el0 = arm->core_mode == ARMV8_64_EL0T;
+	if (el0)
+		armv8_dpm_modeswitch(dpm, ARMV8_64_EL1H);
+
+	uint64_t value = 0;
+	retval = dpm->instr_read_data_r0_64(dpm, ARMV8_MRS(sys, 0), &value);
+
+	if (el0)
+		armv8_dpm_modeswitch(dpm, ARM_MODE_ANY);
+	dpm->finish(dpm);
+	if (retval != ERROR_OK)
+		return retval;
+
+	command_print(CMD, "0x%016" PRIx64, value);
+	return ERROR_OK;
+}
