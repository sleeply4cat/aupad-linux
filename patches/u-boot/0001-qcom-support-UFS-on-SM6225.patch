From e54ea01f8735eaf726941e5e0fe18e383838f8eb Mon Sep 17 00:00:00 2001
From: kirill <sleeply4cat@gmail.com>
Date: Fri, 30 Oct 2026 22:06:46 +0300
Subject: [PATCH 1/9] qcom: support UFS on SM6225

Add the SM6225 UFS PHY tables, the second RX symbol clock and the GDSC, and the
ufs_reset special pin, so U-Boot can load a kernel from UFS.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_015ya7egg5XM6dMvKwj1kAyq
---
 drivers/clk/qcom/clock-sm6115.c       |  5 ++
 drivers/phy/qcom/phy-qcom-qmp-ufs.c   | 92 +++++++++++++++++++++++++++
 drivers/pinctrl/qcom/pinctrl-sm6115.c |  6 ++
 3 files changed, 103 insertions(+)

diff --git a/drivers/clk/qcom/clock-sm6115.c b/drivers/clk/qcom/clock-sm6115.c
index 17c2e561..dd21a834 100644
--- a/drivers/clk/qcom/clock-sm6115.c
+++ b/drivers/clk/qcom/clock-sm6115.c
@@ -16,6 +16,9 @@
 
 #include "clock-qcom.h"
 
+/* Second UFS lane: SM6225 only, not in the SM6115 bindings */
+#define GCC_UFS_PHY_RX_SYMBOL_1_CLK 167
+
 #define QUPV3_WRAP0_S4_CMD_RCGR 0x1f608
 #define SDCC1_APPS_CLK_CMD_RCGR 0x38028
 #define SDCC2_APPS_CLK_CMD_RCGR 0x1e00c
@@ -82,6 +85,7 @@ static const struct gate_clk sm6115_clks[] = {
 	GATE_CLK(GCC_UFS_PHY_ICE_CORE_CLK, 0x45044, 0x00000001),
 	GATE_CLK(GCC_UFS_PHY_PHY_AUX_CLK, 0x45078, 0x00000001),
 	GATE_CLK(GCC_UFS_PHY_RX_SYMBOL_0_CLK, 0x4501c, 0x00000001),
+	GATE_CLK(GCC_UFS_PHY_RX_SYMBOL_1_CLK, 0x4509c, 0x00000001),
 	GATE_CLK(GCC_UFS_PHY_TX_SYMBOL_0_CLK, 0x45018, 0x00000001),
 	GATE_CLK(GCC_UFS_PHY_UNIPRO_CORE_CLK, 0x45040, 0x00000001),
 	GATE_CLK(GCC_USB30_PRIM_MASTER_CLK, 0x1a010, 0x00000001),
@@ -165,6 +169,7 @@ static const struct qcom_reset_map sm6115_gcc_resets[] = {
 };
 
 static const struct qcom_power_map sm6115_gdscs[] = {
+	[GCC_UFS_PHY_GDSC] = { 0x45004 },
 	[GCC_USB30_PRIM_GDSC] = { 0x1a004 },
 };
 
