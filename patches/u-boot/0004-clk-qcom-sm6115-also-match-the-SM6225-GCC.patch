From 44ce2ad8ff45581f76f09173c62fd5e2f88a65de Mon Sep 17 00:00:00 2001
From: kirill <sleeply4cat@gmail.com>
Date: Thu, 5 Nov 2026 03:12:13 +0300
Subject: [PATCH 4/9] clk: qcom: sm6115: also match the SM6225 GCC

SM6225 (khaje) has the same branch clocks, RCG registers, RCG source
numbering and GPLL0 vote as SM6115, for everything this driver touches.
Its device tree now describes the GCC as qcom,sm6225-gcc.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_015ya7ejvazDaFBN5SE4ttFx
---
 drivers/clk/qcom/clock-sm6115.c | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/drivers/clk/qcom/clock-sm6115.c b/drivers/clk/qcom/clock-sm6115.c
index dd21a834..e953c83e 100644
--- a/drivers/clk/qcom/clock-sm6115.c
+++ b/drivers/clk/qcom/clock-sm6115.c
@@ -253,6 +253,11 @@ static const struct udevice_id gcc_sm6115_of_match[] = {
 		.compatible = "qcom,gcc-sm6115",
 		.data = (ulong)&sm6115_gcc_data,
 	},
+	{
+		/* SM6225 (khaje): same branches, RCGs and GPLL0 vote as SM6115 */
+		.compatible = "qcom,sm6225-gcc",
+		.data = (ulong)&sm6115_gcc_data,
+	},
 	{}
 };
 
