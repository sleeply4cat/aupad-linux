From 94500538c1ea4d7f6ee0020867632fc7a08c4e0b Mon Sep 17 00:00:00 2001
From: kirill <sleeply4cat@gmail.com>
Date: Thu, 5 Nov 2026 03:12:13 +0300
Subject: [PATCH 8/9] serial: add a console over Qualcomm EUD COM

The COM function of the Embedded USB Debugger as a serial device, for a
console with neither the UART nor USB in U-Boot. Same protocol as the
Linux driver: whole packets read at once, each acknowledged with a
1-byte packet of ID 0x91 so the host sends the next one; output is
dropped while no host reads.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_015ya7ejvazDaFBN5SE4ttFx
---
 drivers/serial/Kconfig           |   8 ++
 drivers/serial/Makefile          |   1 +
 drivers/serial/serial_qcom_eud.c | 166 +++++++++++++++++++++++++++++++
 3 files changed, 175 insertions(+)
 create mode 100644 drivers/serial/serial_qcom_eud.c

diff --git a/drivers/serial/Kconfig b/drivers/serial/Kconfig
index bcb0c865..6d387336 100644
--- a/drivers/serial/Kconfig
+++ b/drivers/serial/Kconfig
@@ -1018,6 +1018,14 @@ config MSM_SERIAL
 	  for example APQ8016 and MSM8916.
 	  Single baudrate is supported in current implementation (115200).
 
+config SERIAL_QCOM_EUD
+	bool "Console over Qualcomm EUD COM"
+	depends on DM_SERIAL && ARCH_SNAPDRAGON
+	help
+	  Console over the COM peripheral of Qualcomm's Embedded USB Debug,
+	  for a host program that sends one packet at a time and waits for
+	  an acknowledgment. EUD has to be enabled before U-Boot runs.
+
 config MSM_GENI_SERIAL
 	bool "Qualcomm on-chip GENI UART"
 	depends on QCOM_GENI
