diff --git a/drivers/serial/serial_qcom_eud.c b/drivers/serial/serial_qcom_eud.c
new file mode 100644
index 00000000..2d82edc6
--- /dev/null
+++ b/drivers/serial/serial_qcom_eud.c
@@ -0,0 +1,166 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Console over the COM peripheral of Qualcomm's Embedded USB Debug (EUD). Whoever ran before
+ * U-Boot has to enable EUD.
+ *
+ * A COM packet is an ID byte, a length and up to 14 bytes, both ways. The host sends one packet
+ * at a time and waits for an acknowledgment, a 1-byte packet with ID EUD_COM_ACK_ID: while a
+ * packet is pending the hardware fails any further transfer, and one that collides with a packet
+ * being read can shorten or drop it. Same protocol as Linux's qcom_eud_serial.
+ */
+
+#include <dm.h>
+#include <serial.h>
+#include <asm/io.h>
+#include <linux/bitops.h>
+#include <linux/kernel.h>
+
+#define EUD_COM_TX_ID		0x00
+#define EUD_COM_TX_LEN		0x04
+#define EUD_COM_TX_DAT		0x08
+#define EUD_COM_RX_ID		0x0c
+#define EUD_COM_RX_LEN		0x10
+#define EUD_COM_RX_DAT		0x14
+#define EUD_INT_STATUS		0x44
+#define EUD_INT_RX		BIT(0)
+#define EUD_INT_TX		BIT(1)
+#define EUD_CTL_OUT		0x70	/* mirrors the host's control register */
+#define EUD_CTL_COM_EN		BIT(5)
+
+#define EUD_COM_PACKET_ID	0x90
+#define EUD_COM_ACK_ID		0x91
+#define EUD_COM_PACKET_MAX	14
+#define EUD_COM_TX_POLLS	100000
+
+struct eud_com_priv {
+	void __iomem *base;
+	u8 rx[EUD_COM_PACKET_MAX];
+	unsigned int rx_len, rx_pos;
+	bool stalled;
+};
+
+static u32 eud_read(struct eud_com_priv *priv, unsigned int reg)
+{
+	return readl(priv->base + reg) & 0xff;
+}
+
+static void eud_write(struct eud_com_priv *priv, unsigned int reg, u32 val)
+{
+	writel(val, priv->base + reg);
+}
+
+/* False if no host is there or it stopped reading: drop output rather than block U-Boot */
+static bool eud_tx_wait(struct eud_com_priv *priv)
+{
+	unsigned int polls = priv->stalled ? 1 : EUD_COM_TX_POLLS;
+
+	if (!(eud_read(priv, EUD_CTL_OUT) & EUD_CTL_COM_EN))
+		return false;
+	while (polls && !(eud_read(priv, EUD_INT_STATUS) & EUD_INT_TX))
+		polls--;
+	priv->stalled = !polls;
+	return polls;
+}
+
+static void eud_send(struct eud_com_priv *priv, u8 id, const char *s, unsigned int len)
+{
+	unsigned int i;
+
+	eud_write(priv, EUD_COM_TX_ID, id);
+	eud_write(priv, EUD_COM_TX_LEN, len);
+	for (i = 0; i < len; i++)
+		eud_write(priv, EUD_COM_TX_DAT, s[i]);
+}
+
+static ssize_t eud_com_puts(struct udevice *dev, const char *s, size_t len)
+{
+	struct eud_com_priv *priv = dev_get_priv(dev);
+
+	len = min_t(size_t, len, EUD_COM_PACKET_MAX);
+	if (eud_tx_wait(priv))
+		eud_send(priv, EUD_COM_PACKET_ID, s, len);
+	return len;
+}
+
+static int eud_com_putc(struct udevice *dev, const char ch)
+{
+	return eud_com_puts(dev, &ch, 1) == 1 ? 0 : -EIO;
+}
+
+/* Read a whole pending packet, which releases it, and let the host send the next one. */
+static void eud_rx_fill(struct eud_com_priv *priv)
+{
+	unsigned int id, len, i;
+
+	if (priv->rx_pos < priv->rx_len || !(eud_read(priv, EUD_INT_STATUS) & EUD_INT_RX))
+		return;
+
+	id = eud_read(priv, EUD_COM_RX_ID);
+	len = eud_read(priv, EUD_COM_RX_LEN);
+	priv->rx_pos = 0;
+	priv->rx_len = 0;
+	for (i = 0; i < len; i++) {
+		u8 ch = eud_read(priv, EUD_COM_RX_DAT);
+
+		if (id == EUD_COM_PACKET_ID && priv->rx_len < EUD_COM_PACKET_MAX)
+			priv->rx[priv->rx_len++] = ch;
+	}
+
+	if (eud_tx_wait(priv))
+		eud_send(priv, EUD_COM_ACK_ID, "\x06", 1);
+}
+
+static int eud_com_getc(struct udevice *dev)
+{
+	struct eud_com_priv *priv = dev_get_priv(dev);
+
+	eud_rx_fill(priv);
+	if (priv->rx_pos == priv->rx_len)
+		return -EAGAIN;
+	return priv->rx[priv->rx_pos++];
+}
+
+static int eud_com_pending(struct udevice *dev, bool input)
+{
+	struct eud_com_priv *priv = dev_get_priv(dev);
+
+	if (!input)
+		return 0;
+	eud_rx_fill(priv);
+	return priv->rx_len - priv->rx_pos;
+}
+
+static int eud_com_setbrg(struct udevice *dev, int baudrate)
+{
+	return 0;
+}
+
+static int eud_com_probe(struct udevice *dev)
+{
+	struct eud_com_priv *priv = dev_get_priv(dev);
+
+	priv->base = dev_read_addr_ptr(dev);
+	return priv->base ? 0 : -EINVAL;
+}
+
+static const struct dm_serial_ops eud_com_ops = {
+	.putc		= eud_com_putc,
+	.puts		= eud_com_puts,
+	.getc		= eud_com_getc,
+	.pending	= eud_com_pending,
+	.setbrg		= eud_com_setbrg,
+};
+
+static const struct udevice_id eud_com_ids[] = {
+	{ .compatible = "qcom,eud-com" },
+	{ }
+};
+
+U_BOOT_DRIVER(serial_qcom_eud) = {
+	.name		= "serial_qcom_eud",
+	.id		= UCLASS_SERIAL,
+	.of_match	= eud_com_ids,
+	.priv_auto	= sizeof(struct eud_com_priv),
+	.probe		= eud_com_probe,
+	.ops		= &eud_com_ops,
+};
