+static int ft8201p_on(struct ft8201p *ctx)
+{
+	struct mipi_dsi_device *dsi = ctx->dsi;
+	const u8 *p = ft8201p_init;
+	ssize_t ret;
+
+	while (p < ft8201p_init + sizeof(ft8201p_init)) {
+		struct mipi_dsi_msg msg = {
+			.channel = dsi->channel,
+			.type = MIPI_DSI_GENERIC_LONG_WRITE,
+			.flags = MIPI_DSI_MSG_USE_LPM,
+			.tx_buf = p + 2,
+			.tx_len = p[1],
+		};
+
+		ret = dsi->host->ops->transfer(dsi->host, &msg);
+		if (ret < 0) {
+			dev_err(&dsi->dev, "init command at %td failed: %zd\n",
+				p - ft8201p_init, ret);
+			return ret;
+		}
+		if (p[0])
+			msleep(p[0]);
+		p += 2 + p[1];
+	}
+
+	return 0;
+}
+
+static int ft8201p_prepare(struct drm_panel *panel)
+{
+	struct ft8201p *ctx = to_ft8201p(panel);
+	int ret;
+
+	ret = regulator_enable(ctx->vddio);
+	if (ret)
+		return ret;
+	msleep(20);
+
+	gpiod_set_value_cansleep(ctx->enp, 1);
+	usleep_range(5000, 6000);
+	gpiod_set_value_cansleep(ctx->enn, 1);
+	usleep_range(5000, 6000);
+
+	gpiod_set_value_cansleep(ctx->reset, 0);
+	msleep(10);
+	gpiod_set_value_cansleep(ctx->reset, 1);
+	msleep(20);
+	gpiod_set_value_cansleep(ctx->reset, 0);
+	msleep(100);
+
+	ret = ft8201p_on(ctx);
+	if (ret) {
+		gpiod_set_value_cansleep(ctx->enn, 0);
+		gpiod_set_value_cansleep(ctx->enp, 0);
+		regulator_disable(ctx->vddio);
+	}
+
+	return ret;
+}
+
+static int ft8201p_unprepare(struct drm_panel *panel)
+{
+	struct ft8201p *ctx = to_ft8201p(panel);
+	struct mipi_dsi_device *dsi = ctx->dsi;
+
+	mipi_dsi_dcs_set_display_off(dsi);
+	msleep(50);
+	mipi_dsi_dcs_enter_sleep_mode(dsi);
+	msleep(150);
+
+	/* Reset stays high: the stock DT has reset-gpio-always-on */
+	gpiod_set_value_cansleep(ctx->enn, 0);
+	gpiod_set_value_cansleep(ctx->enp, 0);
+	regulator_disable(ctx->vddio);
+
+	return 0;
+}
+
+static const struct drm_display_mode ft8201p_mode = {
+	.clock = (1200 + 48 + 20 + 38) * (1920 + 224 + 6 + 32) * 60 / 1000,
+	.hdisplay = 1200,
+	.hsync_start = 1200 + 48,
+	.hsync_end = 1200 + 48 + 20,
+	.htotal = 1200 + 48 + 20 + 38,
+	.vdisplay = 1920,
+	.vsync_start = 1920 + 224,
+	.vsync_end = 1920 + 224 + 6,
+	.vtotal = 1920 + 224 + 6 + 32,
+	.width_mm = 147,
+	.height_mm = 236,
+	.type = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED,
+};
+
+static int ft8201p_get_modes(struct drm_panel *panel, struct drm_connector *connector)
+{
+	return drm_connector_helper_get_modes_fixed(connector, &ft8201p_mode);
+}
+
+static enum drm_panel_orientation ft8201p_get_orientation(struct drm_panel *panel)
+{
+	return to_ft8201p(panel)->orientation;
+}
+
+static const struct drm_panel_funcs ft8201p_funcs = {
+	.prepare = ft8201p_prepare,
+	.unprepare = ft8201p_unprepare,
+	.get_modes = ft8201p_get_modes,
+	.get_orientation = ft8201p_get_orientation,
+};
+
+static int ft8201p_probe(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	struct ft8201p *ctx;
+	int ret;
+
+	ctx = devm_drm_panel_alloc(dev, struct ft8201p, panel, &ft8201p_funcs,
+				   DRM_MODE_CONNECTOR_DSI);
+	if (IS_ERR(ctx))
+		return PTR_ERR(ctx);
+
+	ctx->vddio = devm_regulator_get(dev, "vddio");
+	if (IS_ERR(ctx->vddio))
+		return dev_err_probe(dev, PTR_ERR(ctx->vddio), "no vddio\n");
+
+	/* ABL leaves the panel running: claim everything without a glitch */
+	ctx->reset = devm_gpiod_get(dev, "reset", GPIOD_OUT_LOW);
+	if (IS_ERR(ctx->reset))
+		return dev_err_probe(dev, PTR_ERR(ctx->reset), "no reset gpio\n");
+	ctx->enp = devm_gpiod_get(dev, "enp", GPIOD_OUT_HIGH);
+	if (IS_ERR(ctx->enp))
+		return dev_err_probe(dev, PTR_ERR(ctx->enp), "no enp gpio\n");
+	ctx->enn = devm_gpiod_get(dev, "enn", GPIOD_OUT_HIGH);
+	if (IS_ERR(ctx->enn))
+		return dev_err_probe(dev, PTR_ERR(ctx->enn), "no enn gpio\n");
+
+	ret = drm_of_get_panel_orientation(dev->of_node, &ctx->orientation);
+	if (ret)
+		return dev_err_probe(dev, ret, "bad rotation\n");
+
+	ret = drm_panel_of_backlight(&ctx->panel);
+	if (ret)
+		return dev_err_probe(dev, ret, "no backlight\n");
+
+	ctx->dsi = dsi;
+	ctx->panel.prepare_prev_first = true;
+	mipi_dsi_set_drvdata(dsi, ctx);
+
+	dsi->lanes = 4;
+	dsi->format = MIPI_DSI_FMT_RGB888;
+	dsi->mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_LPM;
+
+	drm_panel_add(&ctx->panel);
+
+	ret = mipi_dsi_attach(dsi);
+	if (ret) {
+		drm_panel_remove(&ctx->panel);
+		return dev_err_probe(dev, ret, "attach failed\n");
+	}
+
+	return 0;
+}
+
+static void ft8201p_remove(struct mipi_dsi_device *dsi)
+{
+	struct ft8201p *ctx = mipi_dsi_get_drvdata(dsi);
+
+	mipi_dsi_detach(dsi);
+	drm_panel_remove(&ctx->panel);
+}
+
+static const struct of_device_id ft8201p_of_match[] = {
+	{ .compatible = "chuwi,aupad-ft8201p" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, ft8201p_of_match);
+
+static struct mipi_dsi_driver ft8201p_driver = {
+	.probe = ft8201p_probe,
+	.remove = ft8201p_remove,
+	.driver = {
+		.name = "panel-focaltech-ft8201p",
+		.of_match_table = ft8201p_of_match,
+	},
+};
+module_mipi_dsi_driver(ft8201p_driver);
+
+MODULE_DESCRIPTION("FocalTech FT8201P DSI panel of the CHUWI AuPad");
