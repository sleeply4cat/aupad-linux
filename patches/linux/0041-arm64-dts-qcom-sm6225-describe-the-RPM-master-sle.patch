From bba06ad79a0e44b548079bc60b52d20c1fbaad26 Mon Sep 17 00:00:00 2001
From: sleeply4cat <sleeply4cat@gmail.com>
Date: Fri, 13 Nov 2026 22:31:41 +0300
Subject: [PATCH 1/3] arm64: dts: qcom: sm6225: describe the RPM master sleep
 statistics

The stock khaje DT keeps five master-stats v2 structures in RPM MSG RAM
at 0x45f0150 with a 0x1000 stride (APSS, MPSS, ADSP, CDSP, TZ).  Slice
the region out and wire it to qcom,rpm-master-stats, so the
rpm_master_stats module can tell which master keeps the chip out of XO
shutdown and power collapse while hunting for the missing vlow/vmin.

Signed-off-by: kirill <sleeply4cat@gmail.com>
---
 arch/arm64/boot/dts/qcom/sm6225.dtsi | 45 ++++++++++++++++++++++++++++
 1 file changed, 45 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm6225.dtsi b/arch/arm64/boot/dts/qcom/sm6225.dtsi
index 9e6537d70..9f503c885 100644
--- a/arch/arm64/boot/dts/qcom/sm6225.dtsi
+++ b/arch/arm64/boot/dts/qcom/sm6225.dtsi
@@ -118,6 +118,51 @@ adsp_rpc_remote_heap_mem: adsp-rpc-remote-heap {
 	};
 };
 
+/*
+ * The RPM keeps per-master sleep statistics in MSG RAM: five v2 structs
+ * starting at 0x150 with a 0x1000 stride, from the stock khaje DT.  The
+ * rpm_master_stats driver exposes them in debugfs to find which master
+ * keeps the chip out of XO shutdown / power collapse.
+ */
+&rpm_msg_ram {
+	#address-cells = <1>;
+	#size-cells = <1>;
+	ranges = <0 0x0 0x045f0000 0x7000>;
+
+	apss_master_stats: sram@150 {
+		reg = <0x150 0x50>;
+	};
+
+	mpss_master_stats: sram@1150 {
+		reg = <0x1150 0x50>;
+	};
+
+	adsp_master_stats: sram@2150 {
+		reg = <0x2150 0x50>;
+	};
+
+	cdsp_master_stats: sram@3150 {
+		reg = <0x3150 0x50>;
+	};
+
+	tz_master_stats: sram@4150 {
+		reg = <0x4150 0x50>;
+	};
+
+};
+
+&rpm {
+	master-stats {
+		compatible = "qcom,rpm-master-stats";
+		qcom,rpm-msg-ram = <&apss_master_stats>,
+				   <&mpss_master_stats>,
+				   <&adsp_master_stats>,
+				   <&cdsp_master_stats>,
+				   <&tz_master_stats>;
+		qcom,master-names = "APSS", "MPSS", "ADSP", "CDSP", "TZ";
+	};
+};
+
 &pil_ipa_fw_mem {
 	reg = <0x0 0x55600000 0x0 0x10000>;
 };
