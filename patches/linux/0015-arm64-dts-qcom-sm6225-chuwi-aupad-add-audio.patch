+			regulator-min-microvolt = <1700000>;
+			regulator-max-microvolt = <1900000>;
+		};
+
 		vreg_l15a: l15 {
 			regulator-min-microvolt = <3050000>;
 			regulator-max-microvolt = <3540000>;
diff --git a/arch/arm64/boot/dts/qcom/sm6225.dtsi b/arch/arm64/boot/dts/qcom/sm6225.dtsi
index 5859f2637..dd62b0dbf 100644
--- a/arch/arm64/boot/dts/qcom/sm6225.dtsi
+++ b/arch/arm64/boot/dts/qcom/sm6225.dtsi
@@ -10,6 +10,9 @@
  * SNPS femto USB HS PHY, and the names ABL looks up.
  */
 
+#include <dt-bindings/firmware/qcom,scm.h>
+#include <dt-bindings/soc/qcom,gpr.h>
+#include <dt-bindings/sound/qcom,q6afe.h>
 #include "sm6115.dtsi"
 
 /*
@@ -46,6 +49,17 @@ &pil_adsp_mem {
 	reg = <0x0 0x53800000 0x0 0x1e00000>;
 };
 
+/* Heap of the static audio PD, handed to the ADSP when userspace creates it. */
+&reserved_memory {
+	adsp_rpc_remote_heap_mem: adsp-rpc-remote-heap {
+		compatible = "shared-dma-pool";
+		alloc-ranges = <0x0 0x0 0x0 0xffffffff>;
+		alignment = <0x0 0x400000>;
+		size = <0x0 0x800000>;
+		reusable;
+	};
+};
+
 &pil_ipa_fw_mem {
 	reg = <0x0 0x55600000 0x0 0x10000>;
 };
@@ -80,6 +94,207 @@ &gcc {
 	compatible = "qcom,sm6225-gcc";
 };
 
+/* The khaje ADSP firmware runs AudioReach (GPR), not the APR services of sm6115. */
+&remoteproc_adsp {
+	glink-edge {
+		/delete-node/ apr;
+
+		fastrpc {
+			memory-region = <&adsp_rpc_remote_heap_mem>;
+			qcom,vmids = <QCOM_SCM_VMID_LPASS QCOM_SCM_VMID_ADSP_HEAP>;
+		};
+
+		gpr {
+			compatible = "qcom,gpr";
+			qcom,glink-channels = "adsp_apps";
+			qcom,domain = <GPR_DOMAIN_ID_ADSP>;
+			qcom,intents = <512 20>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			q6apm: service@1 {
+				compatible = "qcom,q6apm";
+				reg = <GPR_APM_MODULE_IID>;
+				#sound-dai-cells = <0>;
+				qcom,protection-domain = "avs/audio",
+							 "msm/adsp/audio_pd";
+
+				q6apmbedai: bedais {
+					compatible = "qcom,q6apm-lpass-dais";
+					#sound-dai-cells = <1>;
+				};
+
+				q6apmdai: dais {
+					compatible = "qcom,q6apm-dais";
+					iommus = <&apps_smmu 0x1c1 0x0>;
+				};
+			};
+
+			q6prm: service@2 {
+				compatible = "qcom,q6prm";
+				reg = <GPR_PRM_MODULE_IID>;
+				qcom,protection-domain = "avs/audio",
+							 "msm/adsp/audio_pd";
+
+				q6prmcc: clock-controller {
+					compatible = "qcom,q6prm-lpass-clocks";
+					#clock-cells = <2>;
+				};
+			};
+		};
+	};
+};
+
+&lpass_tlmm {
+	/* Stock votes only this resource; the firmware fails the LPASS core vote. */
+	clocks = <&q6prmcc LPASS_HW_DCODEC_VOTE LPASS_CLK_ATTRIBUTE_COUPLE_NO>;
+	clock-names = "audio";
+
+	lpass_rx_swr_clk: rx-swr-clk-state {
+		pins = "gpio3";
+		function = "swr_rx_clk";
+		drive-strength = <10>;
+		slew-rate = <3>;
+		bias-disable;
+	};
+
+	lpass_rx_swr_data: rx-swr-data-state {
+		pins = "gpio4", "gpio5";
+		function = "swr_rx_data";
+		drive-strength = <10>;
+		slew-rate = <3>;
+		bias-bus-hold;
+	};
+
+	lpass_tx_swr_clk: tx-swr-clk-state {
+		pins = "gpio0";
+		function = "swr_tx_clk";
+		drive-strength = <10>;
+		slew-rate = <3>;
+		bias-disable;
+	};
+
+	lpass_tx_swr_data: tx-swr-data-state {
+		pins = "gpio1", "gpio2";
+		function = "swr_tx_data";
+		drive-strength = <10>;
+		slew-rate = <3>;
+		bias-bus-hold;
+	};
+};
+
+&soc {
+	lpass_rx_macro: codec@a600000 {
+		compatible = "qcom,sm6115-lpass-rx-macro";
+		reg = <0x0 0x0a600000 0x0 0x1000>;
+
+		pinctrl-0 = <&lpass_rx_swr_clk>, <&lpass_rx_swr_data>;
+		pinctrl-names = "default";
+
+		clocks = <&q6prmcc LPASS_CLK_ID_RX_CORE_MCLK LPASS_CLK_ATTRIBUTE_COUPLE_NO>,
+			 <&q6prmcc LPASS_CLK_ID_RX_CORE_NPL_MCLK LPASS_CLK_ATTRIBUTE_COUPLE_NO>,
+			 <&q6prmcc LPASS_HW_DCODEC_VOTE LPASS_CLK_ATTRIBUTE_COUPLE_NO>,
+			 <&lpass_va_macro>;
+		clock-names = "mclk", "npl", "dcodec", "fsgen";
+
+		#clock-cells = <0>;
+		#sound-dai-cells = <1>;
+
+		status = "disabled";
+	};
+
+	swr0: soundwire@a610000 {
+		compatible = "qcom,soundwire-v1.6.0";
+		reg = <0x0 0x0a610000 0x0 0x2000>;
+
+		interrupts = <GIC_SPI 297 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&lpass_rx_macro>;
+		clock-names = "iface";
+
+		qcom,din-ports = <0>;
+		qcom,dout-ports = <5>;
+
+		qcom,ports-word-length =	/bits/ 8 <0x01 0x07 0x04 0xff 0xff>;
+		qcom,ports-sinterval-low =	/bits/ 8 <0x03 0x3f 0x1f 0x03 0x03>;
+		qcom,ports-offset1 =		/bits/ 8 <0x00 0x00 0x0b 0x01 0x01>;
+		qcom,ports-offset2 =		/bits/ 8 <0x00 0x00 0x0b 0x00 0x00>;
+		qcom,ports-lane-control =	/bits/ 8 <0x01 0x00 0x00 0x00 0x00>;
+		qcom,ports-block-pack-mode =	/bits/ 8 <0xff 0x00 0x01 0xff 0xff>;
+		qcom,ports-hstart =		/bits/ 8 <0xff 0x03 0xff 0xff 0xff>;
+		qcom,ports-hstop =		/bits/ 8 <0xff 0x06 0xff 0xff 0xff>;
+		qcom,ports-block-group-count =	/bits/ 8 <0xff 0xff 0xff 0xff 0x00>;
+
+		#sound-dai-cells = <1>;
+		#address-cells = <2>;
+		#size-cells = <0>;
+
+		status = "disabled";
+	};
+
+	lpass_tx_macro: codec@a620000 {
+		compatible = "qcom,sm6115-lpass-tx-macro";
+		reg = <0x0 0x0a620000 0x0 0x1000>;
+
+		pinctrl-0 = <&lpass_tx_swr_clk>, <&lpass_tx_swr_data>;
+		pinctrl-names = "default";
+
+		clocks = <&q6prmcc LPASS_CLK_ID_TX_CORE_MCLK LPASS_CLK_ATTRIBUTE_COUPLE_NO>,
+			 <&q6prmcc LPASS_CLK_ID_TX_CORE_NPL_MCLK LPASS_CLK_ATTRIBUTE_COUPLE_NO>,
+			 <&q6prmcc LPASS_HW_DCODEC_VOTE LPASS_CLK_ATTRIBUTE_COUPLE_NO>,
+			 <&lpass_va_macro>;
+		clock-names = "mclk", "npl", "dcodec", "fsgen";
+
+		#clock-cells = <0>;
+		#sound-dai-cells = <1>;
+
+		status = "disabled";
+	};
+
+	lpass_va_macro: codec@a730000 {
+		compatible = "qcom,sm6115-lpass-va-macro";
+		reg = <0x0 0x0a730000 0x0 0x1000>;
+
+		clocks = <&q6prmcc LPASS_CLK_ID_VA_CORE_MCLK LPASS_CLK_ATTRIBUTE_COUPLE_NO>,
+			 <&q6prmcc LPASS_CLK_ID_VA_CORE_2X_MCLK LPASS_CLK_ATTRIBUTE_COUPLE_NO>,
+			 <&q6prmcc LPASS_HW_DCODEC_VOTE LPASS_CLK_ATTRIBUTE_COUPLE_NO>;
+		clock-names = "mclk", "npl", "dcodec";
+
+		#clock-cells = <0>;
+		#sound-dai-cells = <1>;
+
+		status = "disabled";
+	};
+
+	/* WCD TX SoundWire hangs off the VA macro here; the TX macro has no master of its own. */
+	swr1: soundwire@a740000 {
+		compatible = "qcom,soundwire-v1.6.0";
+		reg = <0x0 0x0a740000 0x0 0x2000>;
+
+		interrupts = <GIC_SPI 296 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&lpass_va_macro>;
+		clock-names = "iface";
+
+		qcom,din-ports = <3>;
+		qcom,dout-ports = <0>;
+
+		qcom,ports-sinterval-low =	/bits/ 8 <0x01 0x03 0x03>;
+		qcom,ports-offset1 =		/bits/ 8 <0x01 0x00 0x02>;
+		qcom,ports-offset2 =		/bits/ 8 <0x00 0x00 0x00>;
+		qcom,ports-hstart =		/bits/ 8 <0xff 0xff 0xff>;
+		qcom,ports-hstop =		/bits/ 8 <0xff 0xff 0xff>;
+		qcom,ports-word-length =	/bits/ 8 <0xff 0x00 0xff>;
+		qcom,ports-block-pack-mode =	/bits/ 8 <0xff 0xff 0xff>;
+		qcom,ports-block-group-count =	/bits/ 8 <0xff 0xff 0xff>;
+		qcom,ports-lane-control =	/bits/ 8 <0x00 0x01 0x00>;
+
+		#sound-dai-cells = <1>;
+		#address-cells = <2>;
+		#size-cells = <0>;
+
+		status = "disabled";
+	};
+};
+
 &gpucc {
 	compatible = "qcom,sm6225-gpucc";
 };
