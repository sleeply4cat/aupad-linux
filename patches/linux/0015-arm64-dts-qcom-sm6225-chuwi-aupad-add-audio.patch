+		pinctrl-0 = <&spk_amp_left_default>;
+		pinctrl-names = "default";
+	};
 
-		pinctrl-0 = <&vol_up_n>;
+	speaker_amp_right: audio-amplifier-right {
+		compatible = "awinic,aw8738";
+		mode-gpios = <&tlmm 98 GPIO_ACTIVE_HIGH>;
+		awinic,mode = <2>;
+		sound-name-prefix = "SpkrRight";
+		pinctrl-0 = <&spk_amp_right_default>;
 		pinctrl-names = "default";
+	};
 
-		key-volume-up {
-			label = "Volume Up";
-			gpios = <&pm6125_gpios 5 GPIO_ACTIVE_LOW>;
-			linux,code = <KEY_VOLUMEUP>;
-			debounce-interval = <15>;
-			linux,can-disable;
-			wakeup-source;
+	wcd937x: audio-codec {
+		compatible = "qcom,wcd9370-codec";
+
+		pinctrl-0 = <&wcd_default>;
+		pinctrl-names = "default";
+
+		reset-gpios = <&tlmm 92 GPIO_ACTIVE_LOW>;
+
+		vdd-buck-supply = <&vreg_l14a>;
+		vdd-rxtx-supply = <&vreg_l9a>;
+		vdd-px-supply = <&vreg_l9a>;
+
+		qcom,micbias1-microvolt = <1800000>;
+		qcom,micbias2-microvolt = <1800000>;
+		qcom,micbias3-microvolt = <1800000>;
+
+		qcom,rx-device = <&wcd937x_rx>;
+		qcom,tx-device = <&wcd937x_tx>;
+
+		#sound-dai-cells = <1>;
+	};
+
+	sound {
+		compatible = "qcom,sm6225-sndcard";
+		model = "CHUWI-AuPad";
+
+		widgets = "Speaker", "Speakers";
+		pin-switches = "Speakers", "Headphone Jack", "Mic Jack";
+		aux-devs = <&speaker_amp_left>, <&speaker_amp_right>;
+
