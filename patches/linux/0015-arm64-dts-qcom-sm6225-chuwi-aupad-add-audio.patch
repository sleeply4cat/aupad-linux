+				"SpkrLeft IN", "HPHL",
+				"SpkrRight IN", "HPHR",
+				"Speakers", "SpkrLeft OUT",
+				"Speakers", "SpkrRight OUT",
+				"Headphone Jack", "HPHL",
+				"Headphone Jack", "HPHR",
+				"AMIC1", "MIC BIAS1",
+				"AMIC2", "MIC BIAS2",
+				"AMIC2", "Mic Jack",
+				"TX SWR_INPUT4", "ADC1_OUTPUT",
+				"TX SWR_INPUT5", "ADC2_OUTPUT";
+
+		wcd-playback-dai-link {
+			link-name = "WCD Playback";
+
+			codec {
+				sound-dai = <&wcd937x 0>, <&swr0 0>, <&lpass_rx_macro 0>;
+			};
+
+			cpu {
+				sound-dai = <&q6apmbedai RX_CODEC_DMA_RX_0>;
+			};
+
+			platform {
+				sound-dai = <&q6apm>;
+			};
+		};
+
+		wcd-capture-dai-link {
+			link-name = "WCD Capture";
+
+			codec {
+				sound-dai = <&wcd937x 1>, <&swr1 0>, <&lpass_tx_macro 0>;
+			};
+
+			cpu {
+				sound-dai = <&q6apmbedai TX_CODEC_DMA_TX_3>;
+			};
+
+			platform {
+				sound-dai = <&q6apm>;
+			};
 		};
 	};
 
@@ -307,6 +388,19 @@ fuel-gauge@62 {
 	};
 };
 
+&lpass_rx_macro {
+	status = "okay";
+};
+
+&lpass_tx_macro {
+	status = "okay";
+};
+
+&lpass_va_macro {
+	qcom,dmic-sample-rate = <600000>;
+	status = "okay";
+};
+
 &remoteproc_adsp {
 	firmware-name = "qcom/sm6225/aupad/adsp.mdt";
 	status = "okay";
@@ -350,6 +444,32 @@ &ufs_mem_phy {
 	status = "okay";
 };
 
+&swr0 {
+	status = "okay";
+
+	wcd937x_rx: codec@0,4 {
+		compatible = "sdw20217010a00";
+		reg = <0 4>;
+
+		/* HPH, CLSH, COMP, LO, DSD */
+		qcom,rx-port-mapping = <1 2 3 4 5>;
+		qcom,rx-channel-mapping = /bits/ 8 <1 2 1 1 2 1 1 2>;
+	};
+};
+
+&swr1 {
+	status = "okay";
+
+	wcd937x_tx: codec@0,3 {
+		compatible = "sdw20217010a00";
+		reg = <0 3>;
+
+		/* Stock runs ADC1/2 on master port 2, the one on the second data lane. */
+		qcom,tx-port-mapping = <2 2 3 3>;
+		qcom,tx-channel-mapping = /bits/ 8 <1 2 1 1 2 3 3 4 1 2 3 4>;
+	};
+};
+
 /* TZ-owned; touching them stalls the bus. From the stock DT. */
 &tlmm {
 	gpio-reserved-ranges = <0 4>, <14 4>;
@@ -433,6 +553,29 @@ sw_ctrl_default: sw-ctrl-default-state {
 		function = "gpio";
 		bias-pull-down;
 	};
+
+	spk_amp_left_default: spk-amp-left-default-state {
+		pins = "gpio100";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+		output-low;
+	};
+
+	spk_amp_right_default: spk-amp-right-default-state {
+		pins = "gpio98";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+		output-low;
+	};
+
+	wcd_default: wcd-default-state {
+		pins = "gpio92";
+		function = "gpio";
+		drive-strength = <16>;
+		output-high;
+	};
 };
 
 /* PM6125 via RPM.  Minimums are what Android runs, maximums from the stock DT. */
