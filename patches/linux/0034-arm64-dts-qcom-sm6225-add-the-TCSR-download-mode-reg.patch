From 8bd8a8a2d4f0c3d938505863b2303666f3453810 Mon Sep 17 00:00:00 2001
From: sleeply4cat <sleeply4cat@gmail.com>
Date: Thu, 12 Nov 2026 23:46:06 +0300
Subject: [PATCH 34/34] arm64: dts: qcom: sm6225: add the TCSR download-mode
 register

Point the scm node at BOOT_MISC_DETECT, tcsr + 0x13000, so the
download_mode and edl parameters of qcom_scm have a register to act
on, the way sm8450 and sm8350 already do.  The address matches the
downstream bengal DTS: "adb reboot edl" on stock writes this exact
register.
---
 arch/arm64/boot/dts/qcom/sm6225.dtsi | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm6225.dtsi b/arch/arm64/boot/dts/qcom/sm6225.dtsi
index 61fe67c1d..9e6537d70 100644
--- a/arch/arm64/boot/dts/qcom/sm6225.dtsi
+++ b/arch/arm64/boot/dts/qcom/sm6225.dtsi
@@ -804,3 +804,12 @@ cam_mclk2_default: cam-mclk2-default-state {
 		bias-disable;
 	};
 };
+
+/*
+ * TCSR BOOT_MISC_DETECT at 0x3d3000: the cookie register the boot stages
+ * check for EDL and dump modes, armed through the qcom_scm "edl" and
+ * "download_mode" parameters.
+ */
+&scm {
+	qcom,dload-mode = <&tcsr_regs 0x13000>;
+};
-- 
2.43.0

