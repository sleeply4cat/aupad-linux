@@ -221,11 +483,32 @@ vreg_l15a: l15 {
 			regulator-max-microvolt = <3540000>;
 		};
 
+		vreg_l16a: l16 {
+			regulator-min-microvolt = <1700000>;
+			regulator-max-microvolt = <1900000>;
