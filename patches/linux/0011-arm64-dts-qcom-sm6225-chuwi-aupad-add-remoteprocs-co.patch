 #include "sm6225.dtsi"
 #include "pm6125.dtsi"
 #define PM7250B_SID 2
@@ -28,6 +33,7 @@ backlight: backlight {
 
 	aliases {
 		serial0 = &uart4;
+		serial1 = &uart3;
 	};
 
 	chosen {
@@ -47,6 +53,74 @@ framebuffer0: framebuffer@5c000000 {
