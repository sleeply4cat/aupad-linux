 dtb-$(CONFIG_ARCH_QCOM)	+= sm6125-xiaomi-willow.dtb
diff --git a/arch/arm64/boot/dts/qcom/sm6225-chuwi-aupad.dts b/arch/arm64/boot/dts/qcom/sm6225-chuwi-aupad.dts
new file mode 100644
index 000000000..3c60ca456
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/sm6225-chuwi-aupad.dts
@@ -0,0 +1,234 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/dts-v1/;
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+#include "sm6225.dtsi"
+#include "pm6125.dtsi"
+#define PM7250B_SID 2
+#define PM7250B_SID1 3
+#include "pm7250b.dtsi"
+
+/ {
+	model = "CHUWI AuPad";
+	compatible = "chuwi,aupad", "qcom,sm6225";
+	chassis-type = "tablet";
+
+	/* Required for ABL to pick this DTB. */
+	qcom,msm-id = <0x24a 0x10000>, <0x206 0x10000>;
+	qcom,board-id = <0x10022 0>;
+
+	backlight: backlight {
+		compatible = "pwm-backlight";
+		pwms = <&pm6125_pwm 0 106667>;
+		brightness-levels = <0 255>;
+		num-interpolated-steps = <255>;
+		default-brightness-level = <128>;
+	};
+
+	aliases {
+		serial0 = &uart4;
+	};
+
+	chosen {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		stdout-path = "serial0:115200n8";
+
+		/* ABL keeps scanning out its splash buffer (FT8201P, 1200x1920). */
+		framebuffer0: framebuffer@5c000000 {
+			compatible = "simple-framebuffer";
+			reg = <0x0 0x5c000000 0x0 (1200 * 1920 * 4)>;
+			width = <1200>;
+			height = <1920>;
+			stride = <(1200 * 4)>;
+			format = "a8r8g8b8";
+		};
+	};
+};
+
+&sleep_clk {
+	clock-frequency = <32764>;
+};
+
+&xo_board {
+	clock-frequency = <19200000>;
+};
+
+&i2c2 {
+	clock-frequency = <400000>;
+	status = "okay";
+
+	/* ABL leaves GPIO 86 low, so the controller stays in reset until this driver lets go */
+	touchscreen@38 {
+		compatible = "focaltech,ft8201";
+		reg = <0x38>;
+		interrupt-parent = <&tlmm>;
+		interrupts = <80 IRQ_TYPE_EDGE_FALLING>;
+		reset-gpios = <&tlmm 86 GPIO_ACTIVE_LOW>;
+		pinctrl-0 = <&ts_int_default>;
+		pinctrl-names = "default";
+		touchscreen-size-x = <1200>;
+		touchscreen-size-y = <1920>;
+	};
+};
+
+&mdss {
+	status = "okay";
+};
+
+&mdss_dsi0 {
+	vdda-supply = <&vreg_l18a>;
+	status = "okay";
+
+	panel@0 {
+		compatible = "chuwi,aupad-ft8201p";
+		reg = <0>;
+
+		reset-gpios = <&tlmm 82 GPIO_ACTIVE_LOW>;
+		enp-gpios = <&tlmm 102 GPIO_ACTIVE_HIGH>;
+		enn-gpios = <&tlmm 85 GPIO_ACTIVE_HIGH>;
+		vddio-supply = <&vreg_l9a>;
+		backlight = <&backlight>;
+		rotation = <180>;
+
+		port {
+			panel_in: endpoint {
+				remote-endpoint = <&mdss_dsi0_out>;
+			};
+		};
+	};
+};
+
+&mdss_dsi0_out {
+	remote-endpoint = <&panel_in>;
+	data-lanes = <0 1 2 3>;
+};
+
+&mdss_dsi0_phy {
+	vdds-supply = <&vreg_l4a>;
+	status = "okay";
+};
+
+&pm6125_pwm {
+	status = "okay";
+};
+
+&qupv3_id_0 {
+	status = "okay";
+};
+
+&uart4 {
+	status = "okay";
+};
+
+&usb {
+	/* No USB3 PHY yet: clock the PIPE interface from UTMI. */
+	qcom,select-utmi-as-pipe-clk;
+
+	status = "okay";
+};
+
+/* USB 2.0 only until the QMP USB3/DP combo PHY is described. */
+&usb_dwc3 {
+	dr_mode = "peripheral";
+	maximum-speed = "high-speed";
+	phys = <&usb_hsphy>;
+	phy-names = "usb2-phy";
+};
+
+&usb_hsphy {
+	vdda-pll-supply = <&vreg_l4a>;
+	vdda18-supply = <&vreg_l12a>;
+	vdda33-supply = <&vreg_l15a>;
+
+	status = "okay";
+};
+
+&gpu {
+	status = "okay";
+};
+
+&i2c1 {
+	clock-frequency = <100000>;
+	status = "okay";
+
+	fuel-gauge@62 {
+		compatible = "cellwise,cw2015";
+		reg = <0x62>;
+	};
+};
+
+&ufs_mem_hc {
+	reset-gpios = <&tlmm 113 GPIO_ACTIVE_LOW>;
+
+	vcc-supply = <&vreg_l24a>;
+	vcc-max-microamp = <800000>;
+	vccq2-supply = <&vreg_l11a>;
+	vccq2-max-microamp = <800000>;
+
+	status = "okay";
+};
+
+&ufs_mem_phy {
+	vdda-phy-supply = <&vreg_l4a>;
+	vdda-pll-supply = <&vreg_l18a>;
+
+	status = "okay";
+};
+
+/* TZ-owned; touching them stalls the bus. From the stock DT. */
+&tlmm {
+	gpio-reserved-ranges = <0 4>, <14 4>;
+
+	ts_int_default: ts-int-default-state {
+		pins = "gpio80";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-up;
+	};
+};
+
+/* PM6125 via RPM.  Minimums are what Android runs, maximums from the stock DT. */
+&rpm_requests {
+	regulators {
+		compatible = "qcom,rpm-pm6125-regulators";
+
+		vreg_l4a: l4 {
+			regulator-min-microvolt = <880000>;
+			regulator-max-microvolt = <1050000>;
+		};
+
+		vreg_l9a: l9 {
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1800000>;
+		};
+
+		vreg_l11a: l11 {
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1950000>;
+		};
+
+		vreg_l12a: l12 {
+			regulator-min-microvolt = <1704000>;
+			regulator-max-microvolt = <1980000>;
+		};
+
+		vreg_l15a: l15 {
+			regulator-min-microvolt = <3050000>;
+			regulator-max-microvolt = <3540000>;
+		};
+
+		vreg_l18a: l18 {
+			regulator-min-microvolt = <1200000>;
+			regulator-max-microvolt = <1300000>;
+		};
+
+		vreg_l24a: l24 {
+			regulator-min-microvolt = <2960000>;
+			regulator-max-microvolt = <3544000>;
+		};
+	};
+};
diff --git a/arch/arm64/boot/dts/qcom/sm6225.dtsi b/arch/arm64/boot/dts/qcom/sm6225.dtsi
new file mode 100644
index 000000000..5859f2637
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/sm6225.dtsi
@@ -0,0 +1,272 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * Qualcomm SM6225 (khaje).
+ *
+ * khaje is a bengal (SM6115) derivative.  Comparing downstream gcc-khaje.c
+ * and pinctrl-khaje.c against the bengal/sm6115 drivers: all 161 shared
+ * clocks use identical registers, and the TLMM tiles sit at the same
+ * absolute addresses with the same pin-to-tile map.  So this builds on
+ * sm6115.dtsi and only overrides what really differs: carve-outs, the
+ * SNPS femto USB HS PHY, and the names ABL looks up.
+ */
+
+#include "sm6115.dtsi"
+
+/*
+ * With the PMU driver bound, about a second of a CPU not reaching idle hangs
+ * the whole SoC, even on one CPU with nothing else probed.  Root cause unknown.
+ */
+/ {
+	/delete-node/ pmu;
+};
+
+/*
+ * ABL looks the splash carve-out up by node name and label.  Without it, ABL
+ * tears the display down at ExitBootServices, and the boot hangs there.
+ */
+/delete-node/ &cont_splash_memory;
+/delete-node/ &dfps_data_memory;
+
+&reserved_memory {
+	cont_splash_mem: splash_region@5c000000 {
+		label = "cont_splash_region";
+		reg = <0x0 0x5c000000 0x0 0xf00000>;
+		no-map;
+	};
+
+	dfps_data_mem: dfps_data_region@5cf00000 {
+		label = "dfps_data_region";
+		reg = <0x0 0x5cf00000 0x0 0x100000>;
+		no-map;
+	};
+};
+
+/* Carve-outs that moved relative to sm6115, from the stock khaje DT. */
+&pil_adsp_mem {
+	reg = <0x0 0x53800000 0x0 0x1e00000>;
+};
+
+&pil_ipa_fw_mem {
+	reg = <0x0 0x55600000 0x0 0x10000>;
+};
+
+&pil_ipa_gsi_mem {
+	reg = <0x0 0x55610000 0x0 0x5000>;
+};
+
+&pil_gpu_mem {
+	reg = <0x0 0x55615000 0x0 0x2000>;
+};
+
+&pil_video_mem {
+	reg = <0x0 0x55617000 0x0 0x700000>;
+};
+
+/* khaje replaces the QUSB2 PHY with a SNPS femto (7 nm) HS PHY at the same address. */
+&usb_hsphy {
+	compatible = "qcom,sm6225-usb-hs-phy", "qcom,usb-snps-hs-7nm-phy";
+	reg = <0x0 0x01613000 0x0 0x110>;
+	clocks = <&rpmcc RPM_SMD_XO_CLK_SRC>;
+	clock-names = "ref";
+	resets = <&gcc GCC_QUSB2PHY_PRIM_BCR>;
+	/delete-property/ nvmem-cells;
+};
+
+&dispcc {
+	compatible = "qcom,sm6225-dispcc";
+};
+
+&gcc {
+	compatible = "qcom,sm6225-gcc";
+};
+
+&gpucc {
+	compatible = "qcom,sm6225-gpucc";
+};
+
+/delete-node/ &gpu_opp_table;
+
+/*
+ * Rates, corners and DDR votes from speed bin 0 of the stock DT.  The bin fuse is elsewhere
+ * on khaje and bengal's bin table doesn't apply, so no speed_bin cell.
+ */
+&gpu {
+	/delete-property/ nvmem-cells;
+	/delete-property/ nvmem-cell-names;
+
+	interconnects = <&bimc MASTER_GRAPHICS_3D RPM_ALWAYS_TAG
+			 &bimc SLAVE_EBI_CH0 RPM_ALWAYS_TAG>;
+
+	gpu_opp_table: opp-table {
+		compatible = "operating-points-v2";
+
+		opp-320000000 {
+			opp-hz = /bits/ 64 <320000000>;
+			required-opps = <&rpmpd_opp_low_svs>;
+			opp-peak-kBps = <4273437>;
+		};
+
+		opp-465000000 {
+			opp-hz = /bits/ 64 <465000000>;
+			required-opps = <&rpmpd_opp_svs>;
+			opp-peak-kBps = <6000000>;
+		};
+
+		opp-600000000 {
+			opp-hz = /bits/ 64 <600000000>;
+			required-opps = <&rpmpd_opp_svs_plus>;
+			opp-peak-kBps = <7945312>;
+		};
+
+		opp-785000000 {
+			opp-hz = /bits/ 64 <785000000>;
+			required-opps = <&rpmpd_opp_nom>;
+			opp-peak-kBps = <12148437>;
+		};
+
+		opp-1025000000 {
+			opp-hz = /bits/ 64 <1025000000>;
+			required-opps = <&rpmpd_opp_turbo>;
+			opp-peak-kBps = <14093750>;
+		};
+
+		opp-1114800000 {
+			opp-hz = /bits/ 64 <1114800000>;
+			required-opps = <&rpmpd_opp_turbo_plus>;
+			opp-peak-kBps = <16343750>;
+		};
+
+		opp-1260000000 {
+			opp-hz = /bits/ 64 <1260000000>;
+			required-opps = <&rpmpd_opp_turbo_plus>;
+			opp-peak-kBps = <16343750>;
+		};
+	};
+};
+
+/*
+ * MDSS registers need the dispcc AHB clock too.  ABL leaves it on, so the first enable works, but
+ * after any power cycle HW_VERSION reads junk until the DPU driver resumes, and UBWC setup is skipped.
+ */
+&mdss {
+	clocks = <&gcc GCC_DISP_AHB_CLK>,
+		 <&dispcc DISP_CC_MDSS_AHB_CLK>,
+		 <&gcc GCC_DISP_HF_AXI_CLK>,
+		 <&dispcc DISP_CC_MDSS_MDP_CLK>;
+};
+
+/* Display block layout is sm6115's, but the DSI PHY is 7 nm, v4.1 */
+&mdss_dsi0_phy {
+	compatible = "qcom,sm6375-dsi-phy-7nm";
+	reg = <0x0 0x05e94400 0x0 0x200>,
+	      <0x0 0x05e94600 0x0 0x280>,
+	      <0x0 0x05e94900 0x0 0x260>;
+	reg-names = "dsi_phy", "dsi_phy_lane", "dsi_pll";
+};
+
+/* The core clock steps differ from sm6115: rates and corners from dispcc-khaje.c */
+&mdp_opp_table {
+	/delete-node/ opp-192000000;
+	/delete-node/ opp-256000000;
+	/delete-node/ opp-307200000;
+	/delete-node/ opp-384000000;
+
+	opp-200000000 {
+		opp-hz = /bits/ 64 <200000000>;
+		required-opps = <&rpmpd_opp_low_svs>;
+	};
+
+	opp-300000000 {
+		opp-hz = /bits/ 64 <300000000>;
+		required-opps = <&rpmpd_opp_svs>;
+	};
+
+	opp-383000000 {
+		opp-hz = /bits/ 64 <383000000>;
+		required-opps = <&rpmpd_opp_svs_plus>;
+	};
+
+	opp-470000000 {
+		opp-hz = /bits/ 64 <470000000>;
+		required-opps = <&rpmpd_opp_nom>;
+	};
+
+	opp-560000000 {
+		opp-hz = /bits/ 64 <560000000>;
+		required-opps = <&rpmpd_opp_turbo>;
+	};
+};
+
+/* khaje UFS is two-lane QMP v4, capped at HS-G3 (sm6115: one lane, v2). */
+&ufs_mem_hc {
+	compatible = "qcom,sm6225-ufshc", "qcom,ufshc", "jedec,ufs-2.0";
+	lanes-per-direction = <2>;
+	limit-hs-gear = <3>;
+
+	clocks = <&gcc GCC_UFS_PHY_AXI_CLK>,
+		 <&gcc GCC_SYS_NOC_UFS_PHY_AXI_CLK>,
+		 <&gcc GCC_UFS_PHY_AHB_CLK>,
+		 <&gcc GCC_UFS_PHY_UNIPRO_CORE_CLK>,
+		 <&rpmcc RPM_SMD_XO_CLK_SRC>,
+		 <&gcc GCC_UFS_PHY_TX_SYMBOL_0_CLK>,
+		 <&gcc GCC_UFS_PHY_RX_SYMBOL_0_CLK>,
+		 <&gcc GCC_UFS_PHY_RX_SYMBOL_1_CLK>,
+		 <&gcc GCC_UFS_PHY_ICE_CORE_CLK>;
+	clock-names = "core_clk",
+		      "bus_aggr_clk",
+		      "iface_clk",
+		      "core_clk_unipro",
+		      "ref_clk",
+		      "tx_lane0_sync_clk",
+		      "rx_lane0_sync_clk",
+		      "rx_lane1_sync_clk",
+		      "ice_core_clk";
+	freq-table-hz = <50000000 200000000>,
+			<0 0>,
+			<0 0>,
+			<37500000 150000000>,
+			<0 0>,
+			<0 0>,
+			<0 0>,
+			<0 0>,
+			<75000000 300000000>;
+};
+
+&ufs_mem_phy {
+	compatible = "qcom,sm6225-qmp-ufs-phy";
+};
+
+/* sm6115.dtsi maps no CPU zone to a cooling device, so nothing would throttle. */
+&cpu0 { #cooling-cells = <2>; };
+&cpu4 { #cooling-cells = <2>; };
+
+#define CPU_ZONE(name, cdev)							\
+	name##-thermal {							\
+		polling-delay-passive = <100>;					\
+		trips {								\
+			name##_alert: trip-point2 {				\
+				temperature = <95000>;				\
+				hysteresis = <2000>;				\
+				type = "passive";				\
+			};							\
+		};								\
+		cooling-maps {							\
+			map0 {							\
+				trip = <&name##_alert>;				\
+				cooling-device = <&cdev THERMAL_NO_LIMIT	\
+						  THERMAL_NO_LIMIT>;		\
+			};							\
+		};								\
+	}
+
+/ {
+	thermal-zones {
+		CPU_ZONE(cpu4, cpu4);
+		CPU_ZONE(cpu5, cpu4);
+		CPU_ZONE(cpu6, cpu4);
+		CPU_ZONE(cpu7, cpu4);
+		CPU_ZONE(cpu45, cpu4);
+		CPU_ZONE(cpu67, cpu4);
+		CPU_ZONE(cpu0123, cpu0);
+	};
+};
