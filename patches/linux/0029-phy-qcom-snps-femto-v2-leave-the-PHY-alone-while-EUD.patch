From 2813d9292771238292ea649edb98a0e216f813fc Mon Sep 17 00:00:00 2001
From: kirill <sleeply4cat@gmail.com>
Date: Thu, 5 Nov 2026 03:11:30 +0300
Subject: [PATCH 29/32] phy: qcom: snps-femto-v2: leave the PHY alone while EUD
 is enabled

With the Embedded USB Debugger on, the PHY carries the EUD hub and its
debug functions. init asserted the PHY reset and reprogrammed it, which
disconnected the debugger about one boot in three on SM6225 and lost
the EUD console's output for a few seconds.

Do what Qualcomm's own driver does: while the EUD enable register reads
1, init only takes the regulator and clock votes, and exit keeps them,
so the PHY stays powered as EUD set it up.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_015ya7ejvazDaFBN5SE4ttFx
The preserved state is tracked explicitly now: phy_initialized alone meant
both "powered" and "programmed", so after an EUD-time init or exit and the
EUD later off, a re-init returned early and the PHY never got programmed.
eud_preserved marks "powered but not programmed"; init programs it with the
resources it already has once the EUD is off, and runtime PM leaves the PHY
alone entirely while the EUD owns it.

---
 drivers/phy/qualcomm/phy-qcom-snps-femto-v2.c | 57 +++++++++++++++++++++++++++++++++++++++++++++++++++++++--
 1 file changed, 55 insertions, 2 deletions (+)

diff --git a/drivers/phy/qualcomm/phy-qcom-snps-femto-v2.c b/drivers/phy/qualcomm/phy-qcom-snps-femto-v2.c
index 980ad1fb1..ce720c0d1 100644
@@ -113,12 +113,14 @@
  *
  * @phy: generic phy
  * @base: iomapped memory space for snps hs phy
+ * @eud_en: EUD enable register, optional
  *
  * @num_clks: number of clocks
  * @clks: array of clocks
  * @phy_reset: phy reset control
  * @vregs: regulator supplies bulk data
  * @phy_initialized: if PHY has been initialized correctly
+ * @eud_preserved: an EUD-time init or exit left the PHY powered but unprogrammed
  * @mode: contains the current mode the PHY is in
  * @update_seq_cfg: tuning parameters for phy init
  */
@@ -127,6 +129,7 @@
 
 	struct phy *phy;
 	void __iomem *base;
+	void __iomem *eud_en;
 
 	int num_clks;
 	struct clk_bulk_data *clks;
@@ -134,6 +137,7 @@
 	struct regulator_bulk_data vregs[SNPS_HS_NUM_VREGS];
 
 	bool phy_initialized;
+	bool eud_preserved;
 	enum phy_mode mode;
 	struct phy_override_seq update_seq_cfg[NUM_HSPHY_TUNING_PARAMS];
 };
@@ -206,11 +210,14 @@
 	return 0;
 }
 
+static bool qcom_snps_hsphy_eud_on(struct qcom_snps_hsphy *hsphy);
+
 static int __maybe_unused qcom_snps_hsphy_runtime_suspend(struct device *dev)
 {
 	struct qcom_snps_hsphy *hsphy = dev_get_drvdata(dev);
 
-	if (!hsphy->phy_initialized)
+	/* Runtime PM must not touch the PHY while the EUD owns it */
+	if (!hsphy->phy_initialized || qcom_snps_hsphy_eud_on(hsphy))
 		return 0;
 
 	return qcom_snps_hsphy_suspend(hsphy);
@@ -220,7 +227,7 @@
 {
 	struct qcom_snps_hsphy *hsphy = dev_get_drvdata(dev);
 
-	if (!hsphy->phy_initialized)
+	if (!hsphy->phy_initialized || qcom_snps_hsphy_eud_on(hsphy))
 		return 0;
 
 	return qcom_snps_hsphy_resume(hsphy);
@@ -383,12 +390,30 @@
 	{},
 };
 
+/*
+ * With the Embedded USB Debugger on, the PHY carries the EUD hub and its debug
+ * functions.  Resetting or reprogramming it disconnects the debugger, so leave
+ * it as the EUD set it up, and keep it powered.
+ */
+static bool qcom_snps_hsphy_eud_on(struct qcom_snps_hsphy *hsphy)
+{
+	return hsphy->eud_en && (readl(hsphy->eud_en) & BIT(0));
+}
+
 static int qcom_snps_hsphy_init(struct phy *phy)
 {
 	struct qcom_snps_hsphy *hsphy = phy_get_drvdata(phy);
 	int ret, i;
 
 	dev_vdbg(&phy->dev, "%s(): Initializing SNPS HS phy\n", __func__);
+
+	/* Still powered from an EUD-time init or exit: if the EUD is off now the PHY has
+	 * never been programmed, so program it with the resources it already has */
+	if (hsphy->phy_initialized) {
+		if (hsphy->eud_preserved && !qcom_snps_hsphy_eud_on(hsphy))
+			goto program;
+		return 0;
+	}
 
 	ret = regulator_bulk_enable(ARRAY_SIZE(hsphy->vregs), hsphy->vregs);
 	if (ret)
@@ -400,6 +425,14 @@
 		goto poweroff_phy;
 	}
 
+	if (qcom_snps_hsphy_eud_on(hsphy)) {
+		dev_info(&phy->dev, "EUD is enabled, leaving the PHY to it\n");
+		hsphy->phy_initialized = true;
+		hsphy->eud_preserved = true;
+		return 0;
+	}
+
+program:
 	ret = reset_control_assert(hsphy->phy_reset);
 	if (ret) {
 		dev_err(&phy->dev, "failed to assert phy_reset, %d\n", ret);
@@ -465,12 +498,16 @@
 					UTMI_PHY_CMN_CTRL_OVERRIDE_EN, 0);
 
 	hsphy->phy_initialized = true;
+	hsphy->eud_preserved = false;
 
 	return 0;
 
 disable_clks:
 	clk_bulk_disable_unprepare(hsphy->num_clks, hsphy->clks);
 poweroff_phy:
+	/* The EUD-preserved path got here with the flags set: it no longer is powered */
+	hsphy->phy_initialized = false;
+	hsphy->eud_preserved = false;
 	regulator_bulk_disable(ARRAY_SIZE(hsphy->vregs), hsphy->vregs);
 
 	return ret;
@@ -479,11 +516,18 @@
 static int qcom_snps_hsphy_exit(struct phy *phy)
 {
 	struct qcom_snps_hsphy *hsphy = phy_get_drvdata(phy);
+
+	/* The EUD owns the PHY: leave its registers and resources exactly as they are */
+	if (qcom_snps_hsphy_eud_on(hsphy)) {
+		hsphy->eud_preserved = true;
+		return 0;
+	}
 
 	reset_control_assert(hsphy->phy_reset);
 	clk_bulk_disable_unprepare(hsphy->num_clks, hsphy->clks);
 	regulator_bulk_disable(ARRAY_SIZE(hsphy->vregs), hsphy->vregs);
 	hsphy->phy_initialized = false;
+	hsphy->eud_preserved = false;
 
 	return 0;
 }
@@ -567,6 +611,7 @@
 	struct qcom_snps_hsphy *hsphy;
 	struct phy_provider *phy_provider;
 	struct phy *generic_phy;
+	struct resource *res;
 	int ret, i;
 	int num;
 
@@ -579,6 +624,14 @@
 	hsphy->base = devm_platform_ioremap_resource(pdev, 0);
 	if (IS_ERR(hsphy->base))
 		return PTR_ERR(hsphy->base);
+
+	/* Not requested: the EUD driver owns this register */
+	res = platform_get_resource(pdev, IORESOURCE_MEM, 1);
+	if (res) {
+		hsphy->eud_en = devm_ioremap(dev, res->start, resource_size(res));
+		if (!hsphy->eud_en)
+			return -ENOMEM;
+	}
 
 	ret = qcom_snps_hsphy_clk_init(hsphy);
 	if (ret)

