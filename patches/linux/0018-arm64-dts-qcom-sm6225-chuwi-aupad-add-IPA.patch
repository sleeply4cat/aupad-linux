From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: kirill <sleeply4cat@gmail.com>
Date: Sat, 31 Oct 2026 03:45:58 +0300
Subject: [PATCH 18/18] arm64: dts: qcom: sm6225-chuwi-aupad: add IPA

Same block as on agatti, plus the IMEM carve-out: without an sram
reference the driver falls back to SC7180's IMEM address. The AP loads
the GSI firmware, from a relocatable image in the existing carve-out.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_015ya7egg5XM6dMvKwj1kAyq
---
 .../boot/dts/qcom/sm6225-chuwi-aupad.dts      |  7 ++
 arch/arm64/boot/dts/qcom/sm6225.dtsi          | 68 +++++++++++++++++++
 2 files changed, 75 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm6225-chuwi-aupad.dts b/arch/arm64/boot/dts/qcom/sm6225-chuwi-aupad.dts
index 1411f8a24..f6321e049 100644
--- a/arch/arm64/boot/dts/qcom/sm6225-chuwi-aupad.dts
+++ b/arch/arm64/boot/dts/qcom/sm6225-chuwi-aupad.dts
@@ -411,6 +411,13 @@ &remoteproc_cdsp {
 	status = "okay";
 };
 
+&ipa {
+	qcom,gsi-loader = "self";
+	memory-region = <&pil_ipa_fw_mem>;
+	firmware-name = "qcom/sm6225/aupad/ipa_fws.mdt";
+	status = "okay";
+};
+
 &remoteproc_mpss {
 	firmware-name = "qcom/sm6225/aupad/modem.mdt";
 	status = "okay";
diff --git a/arch/arm64/boot/dts/qcom/sm6225.dtsi b/arch/arm64/boot/dts/qcom/sm6225.dtsi
index cf940ff7c..8e89a3220 100644
--- a/arch/arm64/boot/dts/qcom/sm6225.dtsi
+++ b/arch/arm64/boot/dts/qcom/sm6225.dtsi
@@ -21,6 +21,19 @@
  */
 / {
 	/delete-node/ pmu;
+
+	smp2p-mpss {
+		ipa_smp2p_out: ipa-ap-to-modem {
+			qcom,entry-name = "ipa";
+			#qcom,smem-state-cells = <1>;
+		};
+
+		ipa_smp2p_in: ipa-modem-to-ap {
+			qcom,entry-name = "ipa";
+			interrupt-controller;
+			#interrupt-cells = <2>;
+		};
+	};
 };
 
 /*
@@ -229,6 +242,61 @@ lpass_tx_swr_data: tx-swr-data-state {
 };
 
 &soc {
+	sram@c100000 {
+		compatible = "mmio-sram";
+		reg = <0x0 0x0c100000 0x0 0x28000>;
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges = <0x0 0x0 0x0c100000 0x28000>;
+
+		ipa_modem_tables: ipa-modem-tables@23000 {
+			reg = <0x23000 0x2000>;
+		};
+	};
+
+	ipa: ipa@5840000 {
+		compatible = "qcom,sm6225-ipa", "qcom,sc7180-ipa";
+
+		iommus = <&apps_smmu 0x140 0x0>;
+		reg = <0x0 0x05840000 0x0 0x7000>,
+		      <0x0 0x05847000 0x0 0x2000>,
+		      <0x0 0x05804000 0x0 0x2c000>;
+		reg-names = "ipa-reg",
+			    "ipa-shared",
+			    "gsi";
+
+		interrupts-extended = <&intc GIC_SPI 257 IRQ_TYPE_EDGE_RISING>,
+				      <&intc GIC_SPI 259 IRQ_TYPE_LEVEL_HIGH>,
+				      <&ipa_smp2p_in 0 IRQ_TYPE_EDGE_RISING>,
+				      <&ipa_smp2p_in 1 IRQ_TYPE_EDGE_RISING>;
+		interrupt-names = "ipa",
+				  "gsi",
+				  "ipa-clock-query",
+				  "ipa-setup-ready";
+
+		clocks = <&rpmcc RPM_SMD_IPA_CLK>;
+		clock-names = "core";
+
+		interconnects = <&system_noc MASTER_IPA RPM_ALWAYS_TAG
+				 &bimc SLAVE_EBI_CH0 RPM_ALWAYS_TAG>,
+				<&system_noc MASTER_IPA RPM_ALWAYS_TAG
+				 &system_noc SLAVE_OCIMEM RPM_ALWAYS_TAG>,
+				<&bimc MASTER_AMPSS_M0 RPM_ACTIVE_TAG
+				 &config_noc SLAVE_IPA_CFG RPM_ACTIVE_TAG>;
+		interconnect-names = "memory",
+				     "imem",
+				     "config";
+
+		qcom,smem-states = <&ipa_smp2p_out 0>,
+				   <&ipa_smp2p_out 1>;
+		qcom,smem-state-names = "ipa-clock-enabled-valid",
+					"ipa-clock-enabled";
+
+		sram = <&ipa_modem_tables>;
+
+		status = "disabled";
+	};
+
 	lpass_rx_macro: codec@a600000 {
 		compatible = "qcom,sm6115-lpass-rx-macro";
 		reg = <0x0 0x0a600000 0x0 0x1000>;
-- 
2.43.0

