From 7b7e67f1e71b4e5fcc5c07e9b03f8b2732f272c1 Mon Sep 17 00:00:00 2001
From: sleeply4cat <sleeply4cat@gmail.com>
Date: Fri, 13 Nov 2026 22:32:01 +0300
Subject: [PATCH 2/3] arm64: dts: qcom: sm6225: wake from deep sleep through
 the MPM

Once the APSS power domain collapses the GIC is unclocked, and only the
MPM's shadow of the wake-capable GIC lines in MSG RAM (vMPM at 0x1b8,
confirmed by the stock khaje DT) still reaches the RPM.  khaje is the
qcm2290 die family, so the node mirrors qcm2290: the APCS mailbox channel
1 notifies the RPM before sleep, and the pin map stands in for the GIC
lines whose wake matters (SPMI for PON/RTC/charging, TSENS, QUSB2, DWC3,
SoundWire).

Route the PMIC arbiter and the tsens0 uplow interrupt through the MPM so
those sources can wake the chip; tsens critical has no MPM pin and stays
on the GIC.

Signed-off-by: kirill <sleeply4cat@gmail.com>
---
 arch/arm64/boot/dts/qcom/sm6225.dtsi | 43 ++++++++++++++++++++++++++++
 1 file changed, 43 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm6225.dtsi b/arch/arm64/boot/dts/qcom/sm6225.dtsi
index 9f503c885..f4f83c5f4 100644
--- a/arch/arm64/boot/dts/qcom/sm6225.dtsi
+++ b/arch/arm64/boot/dts/qcom/sm6225.dtsi
@@ -149,6 +149,9 @@ tz_master_stats: sram@4150 {
 		reg = <0x4150 0x50>;
 	};
 
+	apss_mpm: sram@1b8 {
+		reg = <0x1b8 0x48>;
+	};
 };
 
 &rpm {
@@ -163,6 +166,46 @@ master-stats {
 	};
 };
 
+/*
+ * khaje wakes from deep sleep through the MPM, not the GIC: once the APSS
+ * power domain collapses the GIC is unclocked, and only the MPM's shadow of
+ * the wake-capable GIC lines in MSG RAM (vMPM at 0x1b8) still reaches the
+ * RPM.  The node mirrors qcm2290 (same die family): the pin map carries the
+ * lines whose wake matters here, with the GIC hwirq they stand in for.
+ */
+/ {
+	mpm: interrupt-controller {
+		compatible = "qcom,mpm";
+		qcom,rpm-msg-ram = <&apss_mpm>;
+		interrupts = <GIC_SPI 197 IRQ_TYPE_EDGE_RISING>;
+		mboxes = <&apcs_glb 1>;
+		interrupt-controller;
+		#interrupt-cells = <2>;
+		#power-domain-cells = <0>;
+		interrupt-parent = <&intc>;
+		qcom,mpm-pin-count = <96>;
+		qcom,mpm-pin-map = <2 275>,  /* TSENS0 uplow */
+				   <5 296>,  /* SoundWire master_irq */
+				   <12 422>, /* DWC3 ss_phy_irq */
+				   <24 79>,  /* SoundWire wake_irq */
+				   <86 183>, /* MPM wake, SPMI */
+				   <90 260>; /* QUSB2_PHY DP+DM */
+	};
+};
+
+/* Route the PMIC interrupt through the MPM so PON, RTC and charging wake the chip. */
+&spmi_bus {
+	/delete-property/ interrupts;
+	interrupts-extended = <&mpm 86 IRQ_TYPE_LEVEL_HIGH>;
+};
+
+/* Thermal wake goes through the MPM too; "critical" has no MPM pin and stays on the GIC. */
+&tsens0 {
+	/delete-property/ interrupts;
+	interrupts-extended = <&mpm 2 IRQ_TYPE_LEVEL_HIGH>,
+			      <&intc GIC_SPI 190 IRQ_TYPE_LEVEL_HIGH>;
+};
+
 &pil_ipa_fw_mem {
 	reg = <0x0 0x55600000 0x0 0x10000>;
 };
