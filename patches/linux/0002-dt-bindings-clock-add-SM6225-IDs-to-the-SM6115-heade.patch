From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: kirill <sleeply4cat@gmail.com>
Date: Fri, 30 Oct 2026 22:04:34 +0300
Subject: [PATCH 02/26] dt-bindings: clock: add SM6225 IDs to the SM6115
 headers

SM6225 (khaje) is a bengal derivative and shares sm6115.dtsi, so extend the
SM6115 GCC, dispcc and gpucc headers instead of duplicating them. Stopgap:
upstreaming needs bindings of its own.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_015ya7egg5XM6dMvKwj1kAyq
---
 include/dt-bindings/clock/qcom,gcc-sm6115.h    | 10 ++++++++++
 include/dt-bindings/clock/qcom,sm6115-dispcc.h |  2 ++
 include/dt-bindings/clock/qcom,sm6115-gpucc.h  |  1 +
 3 files changed, 13 insertions(+)

diff --git a/include/dt-bindings/clock/qcom,gcc-sm6115.h b/include/dt-bindings/clock/qcom,gcc-sm6115.h
index b91a7b460..02c5cf600 100644
--- a/include/dt-bindings/clock/qcom,gcc-sm6115.h
+++ b/include/dt-bindings/clock/qcom,gcc-sm6115.h
@@ -172,6 +172,15 @@
 #define GCC_CAMSS_CPHY_2_CLK					164
 #define GCC_UFS_CLKREF_CLK					165
 #define GCC_DISP_GPLL0_CLK_SRC					166
+#define GCC_UFS_PHY_RX_SYMBOL_1_CLK				167
+#define GCC_DISP_SLEEP_CLK				168
+#define GCC_USB3_PRIM_PHY_PIPE_CLK_SRC				169
+#define GPLL0_OUT_EVEN				170
+#define GPLL1				171
+#define GPLL3_OUT_EVEN				172
+#define GPLL5				173
+#define GPLL6_OUT_EVEN				174
+#define GPLL8_OUT_EVEN				175
 
 /* GCC resets */
 #define GCC_QUSB2PHY_PRIM_BCR					0
@@ -186,6 +195,7 @@
 #define GCC_USB3PHY_PHY_PRIM_SP0_BCR				9
 #define GCC_USB3_PHY_PRIM_SP0_BCR				10
 #define GCC_SDCC2_BCR						11
+#define GCC_USB3_DP_PHY_PRIM_BCR				12
 
 /* Indexes for GDSCs */
 #define GCC_CAMSS_TOP_GDSC			0
diff --git a/include/dt-bindings/clock/qcom,sm6115-dispcc.h b/include/dt-bindings/clock/qcom,sm6115-dispcc.h
index ab8d312ad..904bf2018 100644
--- a/include/dt-bindings/clock/qcom,sm6115-dispcc.h
+++ b/include/dt-bindings/clock/qcom,sm6115-dispcc.h
@@ -29,6 +29,8 @@
 #define DISP_CC_MDSS_VSYNC_CLK_SRC	19
 #define DISP_CC_SLEEP_CLK		20
 #define DISP_CC_SLEEP_CLK_SRC		21
+#define DISP_CC_MDSS_RSCC_AHB_CLK	22
+#define DISP_CC_MDSS_RSCC_VSYNC_CLK	23
 
 /* Resets */
 #define DISP_CC_MDSS_CORE_BCR			0
diff --git a/include/dt-bindings/clock/qcom,sm6115-gpucc.h b/include/dt-bindings/clock/qcom,sm6115-gpucc.h
index 945f21a7d..3118578ee 100644
--- a/include/dt-bindings/clock/qcom,sm6115-gpucc.h
+++ b/include/dt-bindings/clock/qcom,sm6115-gpucc.h
@@ -25,6 +25,7 @@
 #define GPU_CC_GX_GFX3D_CLK_SRC		14
 #define GPU_CC_SLEEP_CLK		15
 #define GPU_CC_HLOS1_VOTE_GPU_SMMU_CLK	16
+#define GPU_CC_PLL0_OUT_MAIN		17
 
 /* Resets */
 #define GPU_GX_BCR			0
