From 671f290f89eea7ecf3480e30c6f3f7bd02c26fb8 Mon Sep 17 00:00:00 2001
From: kirill <sleeply4cat@gmail.com>
Date: Sat, 31 Oct 2026 03:45:58 +0300
Subject: [PATCH 17/32] arm64: dts: qcom: sm6225: use the khaje cluster idle
 states

CPU_SUSPEND fails for all of the states inherited from SM6115, so a
cluster never sleeps. Use the single downstream state per cluster, and
add the CCI power collapse above them. Downstream also lists CCI
retention, 0x42000043, but the firmware answers INVALID_PARAMETERS.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_015ya7egg5XM6dMvKwj1kAyq
---
 arch/arm64/boot/dts/qcom/sm6225.dtsi | 45 ++++++++++++++++++++++++++++
 1 file changed, 45 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm6225.dtsi b/arch/arm64/boot/dts/qcom/sm6225.dtsi
index dd62b0dbf..cf940ff7c 100644
--- a/arch/arm64/boot/dts/qcom/sm6225.dtsi
+++ b/arch/arm64/boot/dts/qcom/sm6225.dtsi
@@ -23,6 +23,51 @@ / {
 	/delete-node/ pmu;
 };
 
+/*
+ * Firmware rejects SM6115's cluster states: CPU_SUSPEND fails for all of them,
+ * so a cluster never sleeps.  khaje has one state per cluster, from downstream.
+ */
+&cluster_0_pd {
+	power-domains = <&cci_pd>;
+	domain-idle-states = <&cluster_0_sleep_1>;
+};
+
+&cluster_1_pd {
+	power-domains = <&cci_pd>;
+	domain-idle-states = <&cluster_1_sleep_1>;
+};
+
+&{/cpus/domain-idle-states} {
+	cci_pc: cci-pc {
+		compatible = "domain-idle-state";
+		arm,psci-suspend-param = <0x42000343>;
+		entry-latency-us = <10831>;
+		exit-latency-us = <4506>;
+		min-residency-us = <15338>;
+	};
+};
+
+&{/psci} {
+	cci_pd: power-domain-cci {
+		#power-domain-cells = <0>;
+		domain-idle-states = <&cci_pc>;
+	};
+};
+
+&cluster_0_sleep_1 {
+	arm,psci-suspend-param = <0x41000043>;
+	entry-latency-us = <640>;
+	exit-latency-us = <1664>;
+	min-residency-us = <8094>;
+};
+
+&cluster_1_sleep_1 {
+	arm,psci-suspend-param = <0x41000043>;
+	entry-latency-us = <800>;
+	exit-latency-us = <2118>;
+	min-residency-us = <7376>;
+};
+
 /*
  * ABL looks the splash carve-out up by node name and label.  Without it, ABL
  * tears the display down at ExitBootServices, and the boot hangs there.
-- 
2.43.0

