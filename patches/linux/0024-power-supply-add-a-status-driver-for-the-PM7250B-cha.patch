From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: kirill <sleeply4cat@gmail.com>
Date: Sat, 31 Oct 2026 15:30:53 +0300
Subject: [PATCH 24/27] power: supply: add a status driver for the PM7250B
 charger

PM7250B has an SMB5 charger and a QG gauge block. Both run on what the
bootloader set up, and nothing in mainline reads them. qcom_smbx doesn't
fit: SMB5 has other register offsets, and that driver writes SMB2 init
values at probe.

Report whether USB input is present and what the charger is doing, and
give the battery current from the QG ADC to the fuel gauge over IIO. The
registers and scaling match the vendor driver. Nothing about charging
changes, the only write is the data hold around the ADC read.

Report Discharging while the charger is in a charging state but the
battery loses more than 50 mA, since a 500 mA input can lose to the load.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../power/supply/qcom,pm7250b-charger.yaml    |  45 +++
 drivers/power/supply/Kconfig                  |  10 +
 drivers/power/supply/Makefile                 |   1 +
 drivers/power/supply/qcom_smb5.c              | 282 ++++++++++++++++++
 4 files changed, 338 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/power/supply/qcom,pm7250b-charger.yaml
 create mode 100644 drivers/power/supply/qcom_smb5.c

diff --git a/Documentation/devicetree/bindings/power/supply/qcom,pm7250b-charger.yaml b/Documentation/devicetree/bindings/power/supply/qcom,pm7250b-charger.yaml
new file mode 100644
index 000000000..ae401f7b3
--- /dev/null
+++ b/Documentation/devicetree/bindings/power/supply/qcom,pm7250b-charger.yaml
@@ -0,0 +1,45 @@
+# SPDX-License-Identifier: GPL-2.0 OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/power/supply/qcom,pm7250b-charger.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Qualcomm PM7250B SMB5 charger and QG battery current ADC
+
+maintainers:
+  - kirill <sleeply4cat@gmail.com>
+
+properties:
+  compatible:
+    const: qcom,pm7250b-charger
+
+  reg:
+    items:
+      - description: charger base
+      - description: QG base
+
+  "#io-channel-cells":
+    const: 0
+
+required:
+  - compatible
+  - reg
+  - "#io-channel-cells"
+
+allOf:
+  - $ref: power-supply.yaml#
+
+additionalProperties: false
+
+examples:
+  - |
+    pmic {
+      #address-cells = <1>;
+      #size-cells = <0>;
+
+      charger@1000 {
+        compatible = "qcom,pm7250b-charger";
+        reg = <0x1000>, <0x4800>;
+        #io-channel-cells = <0>;
+      };
+    };
diff --git a/drivers/power/supply/Kconfig b/drivers/power/supply/Kconfig
index b89ef40df..c53c691fa 100644
--- a/drivers/power/supply/Kconfig
+++ b/drivers/power/supply/Kconfig
@@ -1181,6 +1181,16 @@ config CHARGER_QCOM_SMB2
 	  adds support for the SMB2 switch mode battery charger found
 	  in PMI8998 and related PMICs.
 
+config CHARGER_QCOM_SMB5
+	tristate "Qualcomm PM7250B PMIC charger status driver"
+	depends on MFD_SPMI_PMIC
+	depends on IIO
+	help
+	  Say Y here to enable reporting the state of the SMB5 charger in
+	  the PM7250B PMIC, and the battery current measured by its QG
+	  block. The driver only reads: the charger keeps the configuration
+	  it got from the bootloader.
+
 config FUEL_GAUGE_MM8013
 	tristate "Mitsumi MM8013 fuel gauge driver"
 	depends on I2C
diff --git a/drivers/power/supply/Makefile b/drivers/power/supply/Makefile
index f3c0d1006..4765b67d0 100644
--- a/drivers/power/supply/Makefile
+++ b/drivers/power/supply/Makefile
@@ -132,6 +132,7 @@ obj-$(CONFIG_CHARGER_SURFACE)	+= surface_charger.o
 obj-$(CONFIG_BATTERY_CHARGER_SURFACE_RT) += surface-rt-ec.o
 obj-$(CONFIG_BATTERY_UG3105)	+= ug3105_battery.o
 obj-$(CONFIG_CHARGER_QCOM_SMB2)	+= qcom_smbx.o
+obj-$(CONFIG_CHARGER_QCOM_SMB5)	+= qcom_smb5.o
 obj-$(CONFIG_FUEL_GAUGE_MM8013)	+= mm8013.o
 obj-$(CONFIG_MACSMC_POWER)	+= macsmc-power.o
 obj-$(CONFIG_CHARGER_MAX77759)	+= max77759_charger.o
diff --git a/drivers/power/supply/qcom_smb5.c b/drivers/power/supply/qcom_smb5.c
new file mode 100644
index 000000000..0a391f0eb
--- /dev/null
+++ b/drivers/power/supply/qcom_smb5.c
@@ -0,0 +1,282 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Status of the SMB5 charger and the QG battery current ADC in PM7250B.
+ *
+ * Read only: the charger keeps running on what the bootloader configured.
+ * The battery current goes out through IIO, for the fuel gauge to report.
+ */
+
+#include <linux/bits.h>
+#include <linux/iio/iio.h>
+#include <linux/iio/types.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/power_supply.h>
+#include <linux/regmap.h>
+#include <linux/units.h>
+
+#define BATTERY_CHARGER_STATUS_1	0x006
+#define BATTERY_CHARGER_STATUS_MASK	GENMASK(2, 0)
+#define POWER_PATH_STATUS		0x10b
+#define USE_USBIN_BIT			BIT(4)
+#define VALID_INPUT_POWER_SOURCE_BIT	BIT(0)
+
+#define QG_PERPH_SUBTYPE		0x05
+#define QG_ADC_IBAT_5A			3
+#define QG_DATA_CTL2			0x42
+#define QG_DATA_HOLD_BIT		BIT(0)
+#define QG_LAST_ADC_I			0xc6
+
+/* nA per bit, the 5 A ADC has twice the resolution of the 10 A one */
+#define QG_IBAT_LSB_5A_NA		152588
+#define QG_IBAT_LSB_10A_NA		305176
+
+/* Below this the system is drawing more than the input gives */
+#define DISCHARGE_THRESHOLD_UA		50000
+
+enum smb5_charger_status {
+	INHIBIT_CHARGE = 0,
+	TRICKLE_CHARGE,
+	PRE_CHARGE,
+	FULLON_CHARGE,
+	TAPER_CHARGE,
+	TERMINATE_CHARGE,
+	PAUSE_CHARGE,
+	DISABLE_CHARGE,
+};
+
+struct smb5_chip {
+	struct device *dev;
+	struct regmap *regmap;
+	u32 chgr_base;
+	u32 qg_base;
+	int ibat_lsb_na;
+	struct mutex qg_lock;	/* for the hold around the ADC read */
+};
+
+static int smb5_read_ibat(struct smb5_chip *chip, int *raw)
+{
+	__le16 val;
+	int rc, rc2;
+
+	guard(mutex)(&chip->qg_lock);
+
+	rc = regmap_set_bits(chip->regmap, chip->qg_base + QG_DATA_CTL2,
+			     QG_DATA_HOLD_BIT);
+	if (rc)
+		return rc;
+
+	rc = regmap_bulk_read(chip->regmap, chip->qg_base + QG_LAST_ADC_I,
+			      &val, sizeof(val));
+
+	rc2 = regmap_clear_bits(chip->regmap, chip->qg_base + QG_DATA_CTL2,
+				QG_DATA_HOLD_BIT);
+	if (rc)
+		return rc;
+	if (rc2)
+		return rc2;
+
+	/* The ADC counts charge as negative */
+	*raw = -(s16)le16_to_cpu(val);
+	return 0;
+}
+
+static int smb5_get_online(struct smb5_chip *chip, int *online)
+{
+	unsigned int stat;
+	int rc;
+
+	rc = regmap_read(chip->regmap, chip->chgr_base + POWER_PATH_STATUS,
+			 &stat);
+	if (rc)
+		return rc;
+
+	*online = (stat & USE_USBIN_BIT) &&
+		  (stat & VALID_INPUT_POWER_SOURCE_BIT);
+	return 0;
+}
+
+static int smb5_get_status(struct smb5_chip *chip, int *status)
+{
+	unsigned int stat;
+	int online, raw, rc;
+
+	rc = smb5_get_online(chip, &online);
+	if (rc)
+		return rc;
+
+	if (!online) {
+		*status = POWER_SUPPLY_STATUS_DISCHARGING;
+		return 0;
+	}
+
+	rc = regmap_read(chip->regmap,
+			 chip->chgr_base + BATTERY_CHARGER_STATUS_1, &stat);
+	if (rc)
+		return rc;
+
+	switch (stat & BATTERY_CHARGER_STATUS_MASK) {
+	case INHIBIT_CHARGE:
+	case TERMINATE_CHARGE:
+		*status = POWER_SUPPLY_STATUS_FULL;
+		return 0;
+	case PAUSE_CHARGE:
+	case DISABLE_CHARGE:
+		*status = POWER_SUPPLY_STATUS_NOT_CHARGING;
+		return 0;
+	}
+
+	rc = smb5_read_ibat(chip, &raw);
+	if (rc)
+		return rc;
+
+	if (raw * (chip->ibat_lsb_na / 1000) < -DISCHARGE_THRESHOLD_UA)
+		*status = POWER_SUPPLY_STATUS_DISCHARGING;
+	else
+		*status = POWER_SUPPLY_STATUS_CHARGING;
+	return 0;
+}
+
+static int smb5_get_property(struct power_supply *psy,
+			     enum power_supply_property psp,
+			     union power_supply_propval *val)
+{
+	struct smb5_chip *chip = power_supply_get_drvdata(psy);
+
+	switch (psp) {
+	case POWER_SUPPLY_PROP_ONLINE:
+		return smb5_get_online(chip, &val->intval);
+	case POWER_SUPPLY_PROP_STATUS:
+		return smb5_get_status(chip, &val->intval);
+	default:
+		return -EINVAL;
+	}
+}
+
+static const enum power_supply_property smb5_properties[] = {
+	POWER_SUPPLY_PROP_ONLINE,
+	POWER_SUPPLY_PROP_STATUS,
+};
+
+static const struct power_supply_desc smb5_psy_desc = {
+	.name = "pm7250b-charger",
+	.type = POWER_SUPPLY_TYPE_USB,
+	.properties = smb5_properties,
+	.num_properties = ARRAY_SIZE(smb5_properties),
+	.get_property = smb5_get_property,
+};
+
+static int smb5_read_raw(struct iio_dev *indio_dev,
+			 const struct iio_chan_spec *chan, int *val, int *val2,
+			 long mask)
+{
+	struct smb5_chip *chip = iio_priv(indio_dev);
+	int rc;
+
+	switch (mask) {
+	case IIO_CHAN_INFO_RAW:
+		rc = smb5_read_ibat(chip, val);
+		return rc ? rc : IIO_VAL_INT;
+	case IIO_CHAN_INFO_SCALE:
+		/* IIO currents are in mA */
+		*val = chip->ibat_lsb_na;
+		*val2 = MICRO;
+		return IIO_VAL_FRACTIONAL;
+	default:
+		return -EINVAL;
+	}
+}
+
+static const struct iio_info smb5_iio_info = {
+	.read_raw = smb5_read_raw,
+};
+
+static const struct iio_chan_spec smb5_iio_channel = {
+	.type = IIO_CURRENT,
+	.indexed = 1,
+	.info_mask_separate = BIT(IIO_CHAN_INFO_RAW) | BIT(IIO_CHAN_INFO_SCALE),
+};
+
+static int smb5_probe(struct platform_device *pdev)
+{
+	struct power_supply_config psy_cfg = {};
+	struct device *dev = &pdev->dev;
+	struct power_supply *psy;
+	struct iio_dev *indio_dev;
+	struct smb5_chip *chip;
+	unsigned int subtype;
+	int rc;
+
+	indio_dev = devm_iio_device_alloc(dev, sizeof(*chip));
+	if (!indio_dev)
+		return -ENOMEM;
+
+	chip = iio_priv(indio_dev);
+	chip->dev = dev;
+
+	chip->regmap = dev_get_regmap(dev->parent, NULL);
+	if (!chip->regmap)
+		return dev_err_probe(dev, -ENODEV, "Couldn't get regmap\n");
+
+	rc = of_property_read_u32_index(dev->of_node, "reg", 0,
+					&chip->chgr_base);
+	if (rc)
+		return dev_err_probe(dev, rc, "Couldn't read charger base\n");
+
+	rc = of_property_read_u32_index(dev->of_node, "reg", 1,
+					&chip->qg_base);
+	if (rc)
+		return dev_err_probe(dev, rc, "Couldn't read QG base\n");
+
+	rc = devm_mutex_init(dev, &chip->qg_lock);
+	if (rc)
+		return rc;
+
+	rc = regmap_read(chip->regmap, chip->qg_base + QG_PERPH_SUBTYPE,
+			 &subtype);
+	if (rc)
+		return dev_err_probe(dev, rc, "Couldn't read QG subtype\n");
+
+	chip->ibat_lsb_na = subtype == QG_ADC_IBAT_5A ? QG_IBAT_LSB_5A_NA :
+							QG_IBAT_LSB_10A_NA;
+
+	indio_dev->name = "pm7250b-ibat";
+	indio_dev->info = &smb5_iio_info;
+	indio_dev->modes = INDIO_DIRECT_MODE;
+	indio_dev->channels = &smb5_iio_channel;
+	indio_dev->num_channels = 1;
+
+	rc = devm_iio_device_register(dev, indio_dev);
+	if (rc)
+		return dev_err_probe(dev, rc, "Couldn't register IIO device\n");
+
+	psy_cfg.drv_data = chip;
+	psy_cfg.fwnode = dev_fwnode(dev);
+
+	psy = devm_power_supply_register(dev, &smb5_psy_desc, &psy_cfg);
+	if (IS_ERR(psy))
+		return dev_err_probe(dev, PTR_ERR(psy),
+				     "Couldn't register power supply\n");
+
+	return 0;
+}
+
+static const struct of_device_id smb5_of_match[] = {
+	{ .compatible = "qcom,pm7250b-charger" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, smb5_of_match);
+
+static struct platform_driver smb5_driver = {
+	.probe = smb5_probe,
+	.driver = {
+		.name = "qcom-smb5",
+		.of_match_table = smb5_of_match,
+	},
+};
+module_platform_driver(smb5_driver);
+
+MODULE_DESCRIPTION("Qualcomm SMB5 charger status");
+MODULE_LICENSE("GPL");
-- 
