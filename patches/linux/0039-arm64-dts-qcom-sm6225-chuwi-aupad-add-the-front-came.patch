From 15948768d2564de402efd35abeeb6231932b40f5 Mon Sep 17 00:00:00 2001
From: sleeply4cat <sleeply4cat@gmail.com>
Date: Fri, 13 Nov 2026 10:24:27 +0300
Subject: [PATCH] arm64: dts: qcom: sm6225-chuwi-aupad: add the front camera

The GC5035 hangs off CCI master 1, MCLK2 on gpio27 at 19.2 MHz, reset
gpio24, standby gpio70 (powerdown, active low), rails L7/L6/L2 from
PM8008, and feeds csiphy2 with two lanes at 422.4 MHz (full size) or
175.2 MHz (2x2 binning).

The sensor answers at 0x37, not at the 0x3f seen elsewhere: 0x37 is a
reserved SMBus address, which is why i2cdetect and the earlier manual
scans never probed it.
---
 .../boot/dts/qcom/sm6225-chuwi-aupad.dts      | 38 +++++++++++++++++++
 1 file changed, 38 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm6225-chuwi-aupad.dts b/arch/arm64/boot/dts/qcom/sm6225-chuwi-aupad.dts
index 11d35172c..bea5bd7a5 100644
--- a/arch/arm64/boot/dts/qcom/sm6225-chuwi-aupad.dts
+++ b/arch/arm64/boot/dts/qcom/sm6225-chuwi-aupad.dts
@@ -476,6 +476,13 @@ csiphy0_ep: endpoint {
 				remote-endpoint = <&ov13b10_ep>;
 			};
 		};
+
+		port@2 {
+			csiphy2_ep: endpoint {
+				data-lanes = <0 1>;
+				remote-endpoint = <&gc5035_ep>;
+			};
+		};
 	};
 };
 
@@ -523,6 +530,37 @@ ov13b10_ep: endpoint {
 	};
 };
 
+&cci_i2c1 {
+	camera@37 {
+		compatible = "galaxycore,gc5035";
+		reg = <0x37>;
+
+		clocks = <&gcc GCC_CAMSS_MCLK2_CLK>;
+		assigned-clocks = <&gcc GCC_CAMSS_MCLK2_CLK>;
+		assigned-clock-rates = <19200000>;
+
+		reset-gpios = <&tlmm 24 GPIO_ACTIVE_LOW>;
+		powerdown-gpios = <&tlmm 70 GPIO_ACTIVE_LOW>;
+
+		pinctrl-0 = <&cam_mclk2_default>;
+		pinctrl-names = "default";
+
+		dovdd-supply = <&vreg_cam_vio>;
+		avdd-supply = <&vreg_cam_vana_front>;
+		dvdd-supply = <&vreg_cam_vdig_front>;
+
+		orientation = <0>;
+
+		port {
+			gc5035_ep: endpoint {
+				data-lanes = <1 2>;
+				link-frequencies = /bits/ 64 <422400000 175200000>;
+				remote-endpoint = <&csiphy2_ep>;
+			};
+		};
+	};
+};
+
 &lpass_rx_macro {
 	status = "okay";
 };
-- 
