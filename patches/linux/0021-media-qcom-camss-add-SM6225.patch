 #define CSID_CTRL_RESUME_AT_FRAME_BOUNDARY		1
 
+/* PPI bridge between CSIPHY and CSID, present on TFE 530 */
+#define PPI_MODULE_CFG						(0x060)
+#define		PPI_MODULE_CFG_DPHY			0x70
+
 enum csid_iface {
 	CSID_IFACE_PIX,
 	CSID_IFACE_RDI0,
@@ -73,6 +77,9 @@ static void __csid_configure_rx(struct csid_device *csid, struct csid_phy_config
 {
 	u32 val;
 
+	if (csid->ppi_base)
+		writel_relaxed(PPI_MODULE_CFG_DPHY, csid->ppi_base + PPI_MODULE_CFG);
+
 	val = FIELD_PREP(CSI2_RX_CFG0_NUM_ACTIVE_LANES_MASK, phy->lane_cnt - 1);
 	val |= FIELD_PREP(CSI2_RX_CFG0_DLX_INPUT_SEL_MASK, phy->lane_assign);
 	val |= FIELD_PREP(CSI2_RX_CFG0_PHY_NUM_SEL_MASK,
